{
  "name": "iauteur",
  "version": "1.0.0",
  "private": true,
  "description": "iAuteur \u2014 an AI-directed, JSON-driven Remotion video factory: a topic becomes a spec, any LLM directs it, and it renders as tech-explainer video (162 components, 30 design packs, dark/light).",
  "license": "MIT",
  "homepage": "https://github.com/san-gitlogin/iauteur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/san-gitlogin/iauteur.git"
  },
  "bugs": {
    "url": "https://github.com/san-gitlogin/iauteur/issues"
  },
  "keywords": [
    "remotion",
    "video",
    "video-generation",
    "explainer",
    "animation",
    "react",
    "tts",
    "shorts",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "predev": "node scripts/gen-index.mjs",
    "dev": "remotion studio",
    "lint": "node scripts/lint-all.mjs",
    "critique": "node scripts/critique.mjs",
    "new-topic": "node scripts/new-topic.mjs",
    "gen-index": "node scripts/gen-index.mjs",
    "voiceover": "node scripts/gen-voiceover.mjs",
    "render": "node scripts/render-topic.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-video.mjs",
    "chapters": "node scripts/gen-chapters.mjs",
    "upload-kit": "node scripts/gen-upload-kit.mjs",
    "audit": "node scripts/audit-census.mjs && node scripts/audit-census-selftest.mjs && tsc --noEmit && node scripts/lint-all.mjs && node scripts/audio-check.mjs && node scripts/audit-determinism.mjs material",
    "audit:census": "node scripts/audit-census.mjs && node scripts/audit-census-selftest.mjs",
    "audit:census-selftest": "node scripts/audit-census-selftest.mjs",
    "audit:determinism": "node scripts/audit-determinism.mjs",
    "audio-check": "node scripts/audio-check.mjs",
    "normalize": "node scripts/normalize.mjs",
    "check-manifest": "node scripts/check-manifest.mjs",
    "drift-check": "node scripts/drift-check.mjs",
    "schema": "node scripts/gen-schema.mjs",
    "schema-check": "node scripts/gen-schema.mjs --check",
    "template": "node scripts/gen-schema.mjs --template",
    "types": "node scripts/gen-types.mjs",
    "types-check": "node scripts/gen-types.mjs --check",
    "validate-beats": "node scripts/validate-beats.mjs",
    "prompt": "node scripts/gen-prompt.mjs",
    "fix-prompt": "node scripts/gen-fix-prompt.mjs",
    "experiment": "node scripts/experiment.mjs",
    "test-assemble": "node scripts/test-assemble.mjs",
    "test-ui-walkthrough": "node scripts/test-ui-walkthrough.mjs",
    "test-asset-protocol": "node scripts/test-asset-protocol.mjs",
    "test-si-resolver": "node scripts/test-si-resolver.mjs",
    "gate": "node scripts/check-fonts.mjs --quiet && node scripts/check-manifest.mjs && node scripts/drift-check.mjs && node scripts/gen-schema.mjs --check && node scripts/gen-types.mjs --check && node scripts/test-normalize-fleet.mjs && node scripts/test-fix-prompt.mjs && node scripts/test-assemble.mjs && node scripts/test-ui-walkthrough.mjs && node scripts/test-asset-protocol.mjs && node scripts/test-si-resolver.mjs && node scripts/check-viz-kinds.mjs && node scripts/check-hooks.mjs && node scripts/check-recordings.mjs --quiet && node scripts/check-sync.mjs --quiet && node scripts/check-field-use.mjs --quiet && node scripts/check-corrections.mjs --quiet",
    "cast": "node scripts/cast.mjs",
    "snap": "node scripts/snap.mjs",
    "publish-safety": "node scripts/check-publish-safety.mjs",
    "publish-safety:all": "node scripts/check-publish-safety.mjs --tracked",
    "rec-fixture": "node scripts/gen-rec-fixture.mjs",
    "bake-rec": "node scripts/bake-rec.mjs",
    "test-rec": "node scripts/test-rec-lint.mjs && node scripts/test-rec-anchors.mjs && node scripts/test-rec-capture.mjs && node scripts/test-rec-contract.mjs && node scripts/test-rec-sync.mjs && node scripts/test-rec-zoomres.mjs",
    "test-rec-lint": "node scripts/test-rec-lint.mjs",
    "test-rec-contract": "node scripts/test-rec-contract.mjs",
    "test-rec-surface": "node scripts/test-rec-surface.mjs",
    "record": "node scripts/record.mjs",
    "test-rec-capture": "node scripts/test-rec-capture.mjs",
    "check-recordings": "node scripts/check-recordings.mjs",
    "check-fresh": "node scripts/check-fresh.mjs",
    "test-rec-determinism": "node scripts/test-rec-determinism.mjs",
    "test-rec-sync": "node scripts/test-rec-sync.mjs",
    "anchor-spec": "node scripts/anchor-spec.mjs",
    "test-rec-anchors": "node scripts/test-rec-anchors.mjs",
    "captures": "node scripts/gen-captures.mjs sqlite sqlite-act1 sqlite-act2 sqlite-act3",
    "captures-check": "node scripts/gen-captures.mjs sqlite sqlite-act1 sqlite-act2 sqlite-act3 --check",
    "check-fonts": "node scripts/check-fonts.mjs",
    "check-hooks": "node scripts/check-hooks.mjs",
    "check-sync": "node scripts/check-sync.mjs",
    "test-rec-zoomres": "node scripts/test-rec-zoomres.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.484",
    "@remotion/layout-utils": "^4.0.484",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "simple-icons": "^13.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3"
  }
}
