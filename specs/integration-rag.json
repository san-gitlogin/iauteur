  "scenes": [
    {
      "id": "s01", "type": "HOOK", "narration": "Your chatbot keeps making things up. Retrieval-augmented generation is how you finally ground it in real facts.", "durationFrames": 210, "timingSource": "estimated", "background": "zoneA", "transition": "fade",
      "data": {"headline": "STOP THE HALLUCINATIONS", "subtext": "how RAG grounds an LLM", "heroAsset": "lucide:search-check", "headlineAtWord": 1, "heroAtWord": 5}
    },
    {
      "id": "s02", "type": "CONTEXT_METER", "narration": "A model can only see a fixed context window, shared between the system prompt, tools, and conversation history.", "durationFrames": 220, "timingSource": "estimated", "background": "zoneB", "transition": "slide",
      "data": {"context": {"headline": "The [context] window", "atWord": 1, "windowTokens": 128000, "verdict": "only 36k tokens free for your data", "segments": [{"label": "system", "tokens": 4000, "kind": "system"}, {"label": "tools", "tokens": 12000, "kind": "tools"}, {"label": "history", "tokens": 76000, "kind": "history"}, {"label": "free", "tokens": 36000, "kind": "free"}]}}
    },
    {
      "id": "s03", "type": "DIAGRAM", "narration": "So RAG adds a step: retrieve the most relevant facts, then let the model answer using only those.", "durationFrames": 220, "timingSource": "estimated", "background": "zoneC", "transition": "push",
      "data": {"headline": "The [RAG] pipeline", "headlineColor": "blue", "diagram": {"layout": "flow", "direction": "horizontal", "nodes": [{"id": "q", "label": "Query", "asset": "lucide:message-square", "color": "blue", "atWord": 1}, {"id": "r", "label": "Retriever", "asset": "lucide:search", "color": "purple", "atWord": 4}, {"id": "l", "label": "LLM", "asset": "lucide:brain-circuit", "color": "green", "atWord": 8}, {"id": "a", "label": "Answer", "asset": "lucide:check-circle", "color": "green", "atWord": 12}], "edges": [{"from": "q", "to": "r", "atWord": 4}, {"from": "r", "to": "l", "label": "context", "atWord": 8}, {"from": "l", "to": "a", "atWord": 12}]}}
    },
    {
      "id": "s04", "type": "CLOUD_ARCH", "narration": "In production the retriever, an embedding service and a vector database live together inside your cloud.", "durationFrames": 230, "timingSource": "estimated", "background": "zoneA", "transition": "morph",
      "data": {"cloud": {"headline": "Where [RAG] runs", "provider": "aws", "color": "blue", "atWord": 1, "boundaries": [{"id": "reg", "label": "us-east-1", "kind": "region", "atWord": 1}, {"id": "vpc", "label": "vpc-rag", "kind": "vpc", "parent": "reg", "atWord": 2}], "nodes": [{"id": "embed", "label": "Embedder", "asset": "lucide:cpu", "boundary": "vpc", "color": "purple", "atWord": 4}, {"id": "vdb", "label": "Vector DB", "sub": "arn:aws:aoss:index", "asset": "lucide:database", "boundary": "vpc", "color": "blue", "atWord": 6}, {"id": "llm", "label": "LLM API", "asset": "lucide:brain-circuit", "boundary": "reg", "color": "green", "atWord": 9}], "edges": [{"from": "embed", "to": "vdb", "label": "upsert", "atWord": 6}, {"from": "vdb", "to": "llm", "label": "context", "atWord": 9}]}}
    },
    {
