      "data": {"tokenizer": {"headline": "Chunk, then [embed]", "text": "Refunds are issued within 30 days.", "showVectors": true, "atWord": 1, "tokens": [{"text": "Refunds", "id": "1", "color": "blue"}, {"text": "are", "id": "2", "color": "blue"}, {"text": "issued", "id": "3", "color": "purple"}, {"text": "within", "id": "4", "color": "purple"}, {"text": "30", "id": "5", "color": "green"}, {"text": "days", "id": "6", "color": "green"}]}}
    },
    {
      "id": "s06", "type": "DRILL_IN", "narration": "Zoom into the retriever and you find three steps: embed the query, search the index, and rerank the hits.", "durationFrames": 250, "timingSource": "estimated", "background": "zoneC", "transition": "zoom",
      "data": {"drillIn": {"headline": "Inside the [retriever]", "color": "purple", "focusId": "Retriever", "pushAtWord": 8, "atWord": 1,
        "overview": {"layout": "flow", "direction": "horizontal", "nodes": [{"id": "query", "label": "Query", "asset": "lucide:message-square", "atWord": 1}, {"id": "retr", "label": "Retriever", "asset": "lucide:search", "color": "purple", "atWord": 3}, {"id": "gen", "label": "LLM", "asset": "lucide:brain-circuit", "atWord": 5}], "edges": [{"from": "query", "to": "retr", "atWord": 3}, {"from": "retr", "to": "gen", "atWord": 5}]},
        "detail": {"layout": "flow", "direction": "horizontal", "nodes": [{"id": "emb", "label": "Embed", "asset": "lucide:cpu", "color": "purple", "atWord": 1}, {"id": "srch", "label": "Search", "asset": "lucide:search", "color": "blue", "atWord": 1}, {"id": "rr", "label": "Rerank", "asset": "lucide:list-ordered", "color": "green", "atWord": 1}], "edges": [{"from": "emb", "to": "srch", "atWord": 1}, {"from": "srch", "to": "rr", "atWord": 1}]}}}
    },
    {
      "id": "s07", "type": "RETRIEVAL_RANK", "narration": "The reranker reorders the candidates so the truly relevant chunk rises to the top before the model sees it.", "durationFrames": 240, "timingSource": "estimated", "background": "zoneA", "transition": "slide",
      "data": {"retrieval": {"headline": "[Rerank] the hits", "color": "purple", "atWord": 1, "rerankAtWord": 5, "fuseAtWord": 11, "chunks": [{"label": "Refund policy: 30 days", "scoreA": 0.71, "scoreFinal": 0.93, "vec": 0.68, "bm25": 0.82}, {"label": "Shipping terms", "scoreA": 0.80, "scoreFinal": 0.61, "vec": 0.58, "bm25": 0.66}, {"label": "Pricing tiers", "scoreA": 0.63, "scoreFinal": 0.75, "vec": 0.70, "bm25": 0.58}]}}
    },
    {
      "id": "s08", "type": "CONFIDENCE_GATE", "narration": "If the best match is still too weak, a confidence gate stops the model from answering at all.", "durationFrames": 220, "timingSource": "estimated", "background": "zoneB", "transition": "iris",
      "data": {"confidence": {"headline": "The [confidence] gate", "value": 44, "threshold": 70, "mode": "block", "reason": "no grounded source", "style": "linear", "color": "red", "atWord": 1}}
    },
    {
      "id": "s09", "type": "LOG_STREAM", "narration": "Every request leaves a trace: the query embeds, the search returns, and the gate logs its decision.", "durationFrames": 220, "timingSource": "estimated", "background": "zoneC", "transition": "blinds",
      "data": {"logs": {"headline": "The [request] trace", "color": "blue", "atWord": 1, "highlight": 3, "rate": "1.2k/s", "lines": [{"level": "info", "tag": "embed", "text": "query embedded in 18ms"}, {"level": "info", "tag": "search", "text": "8 candidates from vector db"}, {"level": "info", "tag": "rerank", "text": "top score 0.93"}, {"level": "warn", "tag": "gate", "text": "confidence 0.44 < 0.70 threshold"}, {"level": "error", "tag": "gate", "text": "answer blocked: no grounded source"}]}}
    },
    {
      "id": "s10", "type": "TEST_RUNNER", "narration": "You keep it honest with an eval suite that checks whether answers actually stay faithful to the sources.", "durationFrames": 230, "timingSource": "estimated", "background": "zoneA", "transition": "push",
