      "id": "s01", "type": "HOOK", "narration": "The market throws a wall of numbers at you every day. Here is how to actually read them.",
      "durationFrames": 200, "timingSource": "estimated", "background": "zoneA", "transition": "fade",
      "data": {"headline": "READ THE MARKET", "subtext": "five charts, one story", "heroAsset": "lucide:trending-up", "headlineAtWord": 1, "heroAtWord": 4}
    },
    {
      "id": "s02", "type": "TICKER_TAPE", "narration": "It starts as noise: symbols, prices, and percentage moves scrolling past, greens up and reds down.",
      "durationFrames": 220, "timingSource": "estimated", "background": "zoneB", "transition": "slide",
      "data": {"headline": "Markets [today.]", "headlineColor": "green", "ticker": {"color": "green", "featured": "NVDA", "entries": [
