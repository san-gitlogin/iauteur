    },
    {
      "id": "s08", "type": "FUNNEL", "narration": "For customers it is a funnel: many visit, fewer sign up, fewer activate, and a slice pays.",
      "durationFrames": 220, "timingSource": "estimated", "background": "zoneB", "transition": "iris",
      "data": {"headline": "The [conversion] funnel.", "headlineColor": "blue", "funnel": {"color": "blue", "stages": [
