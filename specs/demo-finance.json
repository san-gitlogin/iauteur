        {"label": "Paid", "value": 3400, "color": "orange", "atWord": 14}
      ]}, "source": "ILLUSTRATIVE — DEMO"}
    },
    {
      "id": "s09", "type": "LOGO_VERSUS", "narration": "And often it comes down to two: the incumbent everyone knows against the challenger everyone is switching to.",
      "durationFrames": 210, "timingSource": "estimated", "background": "zoneC", "transition": "zoom",
      "data": {"headline": "The [showdown].", "headlineColor": "orange", "logoVersus": {"color": "orange", "left": {"icon": "si:visa", "name": "Visa", "tagline": "The incumbent", "color": "blue"}, "right": {"icon": "si:stripe", "name": "Stripe", "tagline": "The challenger", "color": "purple"}, "winner": "right"}, "source": "ILLUSTRATIVE — DEMO"}
