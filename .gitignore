# dependencies
node_modules/

# Remotion / build outputs
out/
dist/
build/
.remotion/

# packaged video bundle + any zips (regenerated by `npm run package`)
*.zip

# logs & throwaway audit run-logs (kept: audit/*.json, *.md)
*.log
audit/_*.log
audit/determinism/*.png

# stray backups
*.bak
*.bak.md

# third-party reference kept locally but NOT redistributed (see Credits in README)
remotion-templates-main/
lxb-termivoxed-main/

# generated voiceover audio (regenerated by scripts/voiceover.py)
public/audio/

# Video topics: the RENDERS are local content — 3.9 GB of mp4 and png that git has
# no business holding. The SPECS are not: long.json and shorts.json are the authored
# work product, 1.3 MB for the whole channel, and they are what a second machine needs
# in order to carry on. They were excluded along with the renders until 2026-08-21,
# when moving the work to another laptop showed what that actually cost — the brief →
# topic mapping existed nowhere except in shell commands that had already scrolled
# away. Tracked now. `!topics/*/` is required so git will descend at all.
topics/*
!topics/ledger.json
!topics/*/
topics/*/*
!topics/*/long.json
!topics/*/shorts.json
# generated: renders, thumbnails, upload kits
topics/*/out/
# src/topicsIndex.ts is generated from whatever topics exist — regenerate with
# `npm run gen-index` (auto: predev hook + render-topic self-heal).
src/topicsIndex.ts

# python (webui)
__pycache__/
*.pyc
.venv/
venv/
webui/static/tmp/

# env / secrets — never commit
.env
.env.*
!.env.example
*.local
pat.txt
pat*.txt
*.pat
*token*.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
*.candidate.json

# Screen recordings — local only, never published (docs/SCREEN_RECORDING.md D4)
public/rec/

# Pinned third-party binaries a course records against (LAW 0m: teach the version you ran).
# They are large, platform-specific and not ours to redistribute — demos reference them via
# the {{TOOLS}} token and `prep.requires` tells a fresh clone what to download.
tools/

# The AI-analyst tutorial project: the SOURCE for the "Point AI At It" series.
# Untracked deliberately — it carries a live .env, a Windows .venv, and local probe
# output. Publishing any of it to a public repo is the owner's decision, not a
# side effect of authoring a video. briefs/pointai/ carries what the specs need.
ai-analyst-tutorial/
