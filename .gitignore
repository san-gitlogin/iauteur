# dependencies
node_modules/

# Remotion / build outputs
out/
dist/
build/
.remotion/

# packaged video bundle + any zips (regenerated by `npm run package`)
*.zip

# logs & throwaway audit run-logs (kept: audit/*.json, *.md)
*.log
audit/_*.log
audit/determinism/*.png

# stray backups
*.bak
*.bak.md

# third-party reference kept locally but NOT redistributed (see Credits in README)
remotion-templates-main/

# python (webui)
__pycache__/
*.pyc
.venv/
venv/
webui/static/tmp/

# env / secrets — never commit
.env
.env.*
*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
