# dependencies
node_modules/

# Remotion / build outputs
out/
dist/
build/
.remotion/

# packaged video bundle + any zips (regenerated by `npm run package`)
*.zip

# logs & throwaway audit run-logs (kept: audit/*.json, *.md)
*.log
audit/_*.log
audit/determinism/*.png

# stray backups
*.bak
*.bak.md

# third-party reference kept locally but NOT redistributed (see Credits in README)
remotion-templates-main/
lxb-termivoxed-main/

# generated voiceover audio (regenerated by scripts/voiceover.py)
public/audio/

# video topics are local content, not repo code (ledger.json = channel-wide
# casting history, kept). src/topicsIndex.ts statically imports topic JSONs,
# so it must stay untracked with them — regenerate via `npm run gen-index`
# (auto: predev hook + render-topic self-heal).
topics/*
!topics/ledger.json
src/topicsIndex.ts

# python (webui)
__pycache__/
*.pyc
.venv/
venv/
webui/static/tmp/

# env / secrets — never commit
.env
.env.*
*.local
pat.txt
*.pat
*token*.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
