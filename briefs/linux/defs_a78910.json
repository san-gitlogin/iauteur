    {
     "label": "ss -t state established",
     "atWord": 10,
     "detail": "and the live connections"
    }
   ],
   "stage": [
    {
     "label": "LISTEN :443",
     "atWord": 4,
     "sub": "nginx",
     "text": "waiting",
     "color": "green"
    },
    {
     "label": "LISTEN :22",
     "atWord": 6,
     "sub": "sshd",
     "text": "waiting",
     "color": "green"
    },
    {
     "label": "ESTABLISHED",
     "atWord": 12,
     "sub": "to 10.0.0.9",
     "text": "active",
     "color": "blue"
    }
   ],
   "verdict": "LISTEN means it is up",
   "verdictSub": "if nobody connects, look at the firewall",
   "verdictAtWord": 15
  }
 },
 {
