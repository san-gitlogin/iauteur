  "blurb": "traceroute rerun continuously so a flapping hop shows up as a column of loss.",
  "example": {
   "headline": "mtr keeps [probing]",
   "color": "blue",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "mtr 1.1.1.1",
     "atWord": 2,
     "text": "7. 10.2.0.1   38.2%",
     "detail": "loss builds over time"
    }
   ],
   "stage": [
    {
     "label": "hop 4",
     "atWord": 4,
     "sub": "0.0% loss",
     "text": "stable",
     "color": "green"
    },
    {
     "label": "hop 7",
     "atWord": 6,
     "sub": "38.2% loss",
     "text": "the culprit",
     "color": "red"
    },
    {
     "label": "hop 9",
     "atWord": 8,
     "sub": "0.0% loss",
     "text": "fine",
     "color": "green"
    }
   ],
