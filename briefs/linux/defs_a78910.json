   "verdictAtWord": 11
  }
 },
 {
  "cmd": "netstat",
  "type": "CMD_NETSTAT",
  "name": "CmdNetstat",
  "dataKey": "cmdNetstat",
  "kind": "rows",
  "color": "blue",
  "stageTitle": "the older socket view",
  "blurb": "the legacy tool and the modern flags that replace each of its own.",
  "example": {
   "headline": "netstat still works, [ss is faster]",
   "color": "blue",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "netstat -tulpn",
     "atWord": 2,
     "text": "tcp 0 0 :::443 LISTEN",
     "detail": "the classic incantation"
    }
   ],
   "stage": [
    {
     "label": "netstat -tulpn",
     "atWord": 4,
     "sub": "reads /proc line by line",
     "text": "slow",
     "color": "orange"
    },
    {
     "label": "ss -tulpn",
     "atWord": 6,
     "sub": "asks the kernel directly",
     "text": "fast",
     "color": "green"
    },
    {
     "label": "same output",
     "atWord": 8,
     "sub": "the flags even match",
     "text": "identical"
    }
   ],
   "verdict": "Muscle memory still works",
   "verdictSub": "but ss finishes on a busy box",
   "verdictAtWord": 11
  }
 },
 {
  "cmd": "ss",
  "type": "CMD_SS",
  "name": "CmdSs",
  "dataKey": "cmdSs",
  "kind": "rows",
  "color": "blue",
  "stageTitle": "what is listening",
  "blurb": "sockets grouped by state, so listening and established read apart at a glance.",
  "example": {
   "headline": "ss shows [what is listening]",
   "color": "blue",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "highlight": "-l",
   "steps": [
    {
     "label": "ss -tulpn",
     "atWord": 2,
     "text": "tcp LISTEN 0 511 *:443",
