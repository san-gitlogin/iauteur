     "label": "hop 4",
     "atWord": 6,
     "sub": "your ISP",
     "text": "9 ms",
     "color": "green"
    },
    {
     "label": "hop 7",
     "atWord": 8,
     "sub": "no reply",
     "text": "* * *",
     "color": "red"
