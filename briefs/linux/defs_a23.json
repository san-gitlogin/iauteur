 {
  "cmd": "tac",
  "type": "CMD_TAC",
  "name": "CmdTac",
  "dataKey": "cmdTac",
  "kind": "rows",
  "color": "green",
  "stageTitle": "the same file, reversed",
  "blurb": "the file's lines arriving bottom-up, newest entry first.",
  "example": {
   "headline": "tac is cat, [backwards]",
   "color": "green",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "/var/log",
   "steps": [
    {
     "label": "cat api.log",
     "atWord": 2,
     "text": "09:01 started",
     "detail": "oldest first"
    },
    {
     "label": "tac api.log",
     "atWord": 8,
     "text": "09:47 crashed",
     "detail": "newest first"
    }
   ],
   "stage": [
    {
     "label": "09:47 crashed",
     "atWord": 10,
     "sub": "line 3",
     "text": "first now",
     "color": "green"
    },
    {
     "label": "09:30 warning",
     "atWord": 12,
     "sub": "line 2"
    },
    {
     "label": "09:01 started",
     "atWord": 14,
     "sub": "line 1",
     "text": "last now"
    }
   ],
   "verdict": "Newest first, no flags",
   "verdictSub": "handy when the tail is what matters",
   "verdictAtWord": 16
  }
 },
 {
  "cmd": "more",
