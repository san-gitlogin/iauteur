  "example": {
   "headline": "chmod flips [nine switches]",
   "color": "orange",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~/bin",
   "perms": "rwxr-xr-x",
   "permsAtWord": 6,
   "steps": [
    {
     "label": "chmod 755 deploy.sh",
     "atWord": 2,
     "detail": "numeric form"
    },
    {
     "label": "chmod u=rwx,go=rx deploy.sh",
     "atWord": 11,
     "detail": "the same thing, spelled out"
    }
   ],
   "stage": [],
   "verdict": "7 is read plus write plus execute",
   "verdictSub": "5 drops the write. That is all 755 means.",
