   "verdictAtWord": 14
  }
 },
 {
  "cmd": "sed",
  "type": "CMD_SED",
  "name": "CmdSed",
  "dataKey": "cmdSed",
  "kind": "flow",
  "color": "purple",
  "stageTitle": "text changing as it passes",
  "blurb": "a stream flowing through a substitution and coming out altered, one line at a time.",
  "example": {
   "headline": "sed edits the [stream]",
   "color": "purple",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "highlight": "g",
   "steps": [
    {
     "label": "sed 's/8080/443/' app.conf",
     "atWord": 2,
     "detail": "first match on each line"
    },
    {
     "label": "sed 's/8080/443/g' app.conf",
     "atWord": 10,
     "detail": "g means every match"
    }
   ],
   "stage": [
    {
     "label": "read a line",
     "atWord": 4,
     "sub": "from the file"
    },
    {
     "label": "match s/8080/443/",
     "atWord": 6,
     "sub": "the pattern"
    },
    {
     "label": "emit the change",
     "atWord": 8,
     "sub": "altered line",
     "color": "green"
    },
    {
     "label": "add g",
     "atWord": 12,
     "sub": "every match, not the first",
     "color": "purple"
    }
   ],
   "verdict": "-i edits the file in place",
   "verdictSub": "without it, nothing is saved",
   "verdictAtWord": 15
  }
 },
 {
  "cmd": "xargs",
  "type": "CMD_XARGS",
  "name": "CmdXargs",
  "dataKey": "cmdXargs",
  "kind": "flow",
  "color": "green",
  "stageTitle": "a list becoming arguments",
  "blurb": "names arriving on standard input being handed to a command that only reads arguments.",
  "example": {
   "headline": "xargs turns input into [arguments]",
   "color": "green",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "/var/log",
   "steps": [
    {
     "label": "find . -name '*.log' | rm",
     "atWord": 2,
     "text": "rm: missing operand",
     "detail": "rm reads arguments, not input"
    },
    {
     "label": "find . -name '*.log' | xargs rm",
     "atWord": 11,
     "detail": "now the names become arguments"
    }
   ],
   "stage": [
    {
     "label": "find prints names",
     "atWord": 4,
     "sub": "on standard input"
    },
    {
     "label": "rm expects arguments",
     "atWord": 6,
     "sub": "nothing arrives",
     "text": "fails",
     "color": "red"
    },
    {
     "label": "xargs converts",
     "atWord": 13,
     "sub": "input becomes arguments",
     "color": "green"
    },
    {
     "label": "rm a.log b.log",
     "atWord": 15,
     "sub": "one call, all names",
     "text": "runs",
     "color": "green"
    }
   ],
   "verdict": "-print0 with -0 for odd names",
   "verdictSub": "spaces in filenames break the naive form",
   "verdictAtWord": 18
  }
 },
 {
