 {
  "cmd": "kill",
  "type": "CMD_KILL",
  "name": "CmdKill",
  "dataKey": "cmdKill",
  "kind": "hops",
  "color": "red",
  "stageTitle": "the signal arriving",
  "blurb": "a signal travelling from your terminal through the kernel to the process.",
  "example": {
   "headline": "kill sends a [signal], not a bullet",
   "color": "red",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "token": "SIGTERM (15)",
   "steps": [
    {
     "label": "kill 4821",
     "atWord": 2,
     "detail": "the default is SIGTERM"
    },
    {
     "label": "kill -9 4821",
     "atWord": 11,
     "detail": "SIGKILL, when nothing else works"
    }
   ],
   "stage": [
    {
     "label": "your terminal",
     "atWord": 4,
     "text": "sends"
    },
    {
     "label": "the kernel",
     "atWord": 6,
     "text": "delivers"
    },
    {
     "label": "node (4821)",
     "atWord": 8,
     "sub": "catches it, saves, exits",
     "text": "clean",
     "color": "green"
    },
    {
     "label": "with -9",
     "atWord": 13,
     "sub": "no chance to clean up",
     "text": "abrupt",
     "color": "red"
    }
   ],
   "verdict": "SIGTERM first, always",
   "verdictSub": "-9 loses whatever was unsaved",
   "verdictAtWord": 16
  }
 },
 {
