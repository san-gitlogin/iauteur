[
 {
  "cmd": "ps",
  "type": "CMD_PS",
  "name": "CmdPs",
  "dataKey": "cmdPs",
  "kind": "rows",
  "color": "purple",
  "stageTitle": "a frozen snapshot",
  "blurb": "the process list as a single moment in time, with the PID every other tool needs.",
  "example": {
   "headline": "ps is a [snapshot], not a feed",
   "color": "purple",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "ps aux",
     "atWord": 2,
     "text": "dev 4821 63.2 node",
     "detail": "BSD style"
    },
    {
     "label": "ps -ef",
     "atWord": 9,
     "text": "dev 4821 1 node",
     "detail": "UNIX style, same data"
    }
   ],
   "stage": [
    {
     "label": "PID 4821",
     "atWord": 4,
     "sub": "node",
     "text": "63% cpu",
     "color": "red"
    },
    {
     "label": "PID 1140",
     "atWord": 6,
     "sub": "nginx",
     "text": "8% cpu"
    },
    {
     "label": "PID 1",
     "atWord": 11,
     "sub": "systemd",
     "text": "0% cpu"
    }
   ],
   "verdict": "The PID is what you need",
   "verdictSub": "every other tool asks for that number",
   "verdictAtWord": 14
  }
 },
 {
  "cmd": "pstree",
  "type": "CMD_PSTREE",
  "name": "CmdPstree",
  "dataKey": "cmdPstree",
  "kind": "tree",
  "color": "purple",
  "stageTitle": "who started whom",
  "blurb": "the same processes drawn as a lineage from PID 1 downward.",
  "example": {
   "headline": "pstree shows [who started whom]",
   "color": "purple",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "pstree -p",
     "atWord": 2,
     "text": "systemd(1)-+-nginx(1140)",
     "detail": "the whole family"
    }
   ],
   "stage": [
    {
     "label": "systemd (1)",
     "atWord": 4,
     "sub": "the ancestor of everything",
     "value": 0
    },
    {
     "label": "nginx (1140)",
     "atWord": 6,
     "sub": "started by systemd",
     "value": 1
    },
    {
     "label": "worker (1141)",
     "atWord": 8,
     "sub": "started by nginx",
     "color": "green",
     "value": 2
    },
    {
     "label": "orphan",
     "atWord": 11,
     "sub": "reparented to PID 1",
     "color": "orange",
     "value": 1
    }
   ],
   "verdict": "Kill a parent, PID 1 adopts",
   "verdictSub": "children are never left without one",
   "verdictAtWord": 14
  }
 },
