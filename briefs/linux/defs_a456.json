 {
  "cmd": "nohup",
  "type": "CMD_NOHUP",
  "name": "CmdNohup",
  "dataKey": "cmdNohup",
  "kind": "rows",
  "color": "green",
  "stageTitle": "surviving the logout",
  "blurb": "the hangup signal reaching every child except the one told to ignore it.",
  "example": {
   "headline": "nohup ignores the [hangup]",
   "color": "green",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "./backup.sh &",
     "atWord": 2,
     "detail": "dies when you log out"
    },
    {
     "label": "nohup ./backup.sh &",
     "atWord": 9,
     "text": "nohup: ignoring input",
     "detail": "survives"
    }
   ],
   "stage": [
    {
     "label": "you close the terminal",
     "atWord": 4,
     "sub": "SIGHUP is sent",
     "text": "signal"
    },
    {
     "label": "plain background job",
     "atWord": 6,
     "sub": "receives it",
     "text": "dies",
     "color": "red"
    },
    {
     "label": "under nohup",
     "atWord": 11,
     "sub": "ignores it",
     "text": "lives",
     "color": "green"
    }
   ],
   "verdict": "Output goes to nohup.out",
   "verdictSub": "unless you redirect it yourself",
   "verdictAtWord": 14
  }
 },
 {
  "cmd": "sleep",
  "type": "CMD_SLEEP",
  "name": "CmdSleep",
  "dataKey": "cmdSleep",
  "kind": "flow",
  "color": "blue",
  "stageTitle": "a script, waiting",
  "blurb": "the clock advancing inside a script while nothing else happens.",
  "example": {
   "headline": "sleep pauses [the script]",
   "color": "blue",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "sleep 5",
     "atWord": 2,
     "detail": "seconds by default"
    },
    {
     "label": "sleep 2m",
     "atWord": 8,
     "detail": "m, h and d also work"
    }
   ],
   "stage": [
    {
     "label": "start",
     "atWord": 4,
     "sub": "the script runs"
    },
    {
     "label": "sleep 5",
     "atWord": 6,
     "sub": "nothing happens",
     "text": "5s",
     "color": "orange"
    },
    {
     "label": "resume",
     "atWord": 10,
     "sub": "the next line",
     "color": "green"
    }
   ],
   "verdict": "Blocks, never busy-waits",
   "verdictSub": "it costs no CPU at all",
   "verdictAtWord": 13
  }
 },
 {
  "cmd": "wait",
  "type": "CMD_WAIT",
  "name": "CmdWait",
  "dataKey": "cmdWait",
  "kind": "flow",
  "color": "blue",
  "stageTitle": "holding for the jobs",
  "blurb": "background jobs finishing at their own pace while the script waits for the last one.",
  "example": {
   "headline": "wait holds until [they finish]",
   "color": "blue",
   "atWord": 1,
   "promptLabel": "dev@box",
   "cwd": "~",
   "steps": [
    {
     "label": "./a.sh & ./b.sh &",
     "atWord": 2,
     "detail": "two jobs in the background"
    },
    {
     "label": "wait",
     "atWord": 9,
     "detail": "hold here until both are done"
    }
   ],
   "stage": [
    {
     "label": "job a",
     "atWord": 4,
     "sub": "running",
     "text": "3s"
    },
    {
     "label": "job b",
     "atWord": 6,
     "sub": "running",
     "text": "7s"
    },
    {
     "label": "without wait",
     "atWord": 11,
     "sub": "script exits early",
     "text": "bug",
     "color": "red"
    },
    {
     "label": "with wait",
     "atWord": 13,
     "sub": "script waits for b",
     "text": "correct",
     "color": "green"
    }
   ],
   "verdict": "Without it, the script lies",
   "verdictSub": "it reports done while work is running",
   "verdictAtWord": 16
  }
 },
 {
  "cmd": "lsof",
  "type": "CMD_LSOF",
  "name": "CmdLsof",
  "dataKey": "cmdLsof",
  "kind": "rows",
  "color": "orange",
  "stageTitle": "who is holding it",
  "blurb": "the file, every process holding it open, and the unmount that keeps failing.",
  "example": {
   "headline": "lsof names the [holder]",
   "color": "orange",
   "atWord": 1,
   "promptLabel": "root@box",
   "cwd": "/",
   "highlight": "-i",
   "steps": [
    {
     "label": "umount /mnt/data",
     "atWord": 2,
     "text": "target is busy",
     "detail": "refused"
    },
    {
     "label": "lsof /mnt/data",
     "atWord": 8,
     "text": "tail 4821 api.log",
     "detail": "there is your culprit"
    },
    {
     "label": "lsof -i :443",
     "atWord": 14,
     "text": "nginx 1140 LISTEN",
     "detail": "works for ports too"
    }
   ],
   "stage": [
    {
     "label": "tail (4821)",
     "atWord": 5,
     "sub": "holding api.log",
     "text": "blocks unmount",
     "color": "red"
    },
    {
     "label": "vim (5102)",
     "atWord": 10,
     "sub": "holding conf",
     "text": "blocks unmount",
     "color": "red"
    },
    {
     "label": "nginx (1140)",
     "atWord": 16,
     "sub": "holding port 443",
     "text": "listening",
     "color": "green"
    }
   ],
   "verdict": "A socket counts as a file",
   "verdictSub": "which is why -i finds port conflicts",
   "verdictAtWord": 19
  }
 },
 {
  "cmd": "strace",
