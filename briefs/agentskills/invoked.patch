+test('counter never hands out the same slug twice', t => {
+	const slugify = slugifyWithCounter();
+	t.is(slugify('foo'), 'foo');
+	t.is(slugify('foo'), 'foo-2');
+	t.is(slugify('foo 2'), 'foo-2-1');
+	t.is(slugify('foo 2'), 'foo-2-2');
+	t.is(slugify('foo'), 'foo-3');
+});
+
+test('counter skips a suffixed slug that an earlier literal input already took', t => {
+	const slugify = slugifyWithCounter();
+	t.is(slugify('foo 2'), 'foo-2');
+	t.is(slugify('foo'), 'foo');
+	t.is(slugify('foo'), 'foo-3');
+	t.is(slugify('foo'), 'foo-4');
+});
+
+test('counter output stays unique across many mixed inputs', t => {
+	const slugify = slugifyWithCounter();
+	const inputs = ['foo', 'foo 2', 'foo', 'foo-2', 'foo 2 1', 'foo', 'foo-3', 'foo 2', 'foo-2-2', 'foo', 'foo-1', 'foo 1', 'foo'];
+	const slugs = inputs.map(input => slugify(input));
+	t.is(new Set(slugs).size, slugs.length, `Duplicate slug in: ${slugs.join(', ')}`);
+});
