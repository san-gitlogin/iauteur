{
  "slug": "archify-verify",
  "surface": "vscode",
  "theme": "dark",
  "workspace": "archify-live",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "deviceScaleFactor": 2.4,
  "masterWidth": 3840,
  "fps": 30,
  "maximizePanel": true,
  "steps": [
    {
      "id": "files",
      "action": "run",
      "cmd": "Get-ChildItem iauteur.architecture.* -Name",
      "label": "what the agent produced",
      "focus": "terminal",
      "clearFirst": true,
      "marks": [
        {
          "id": "json",
          "text": "iauteur.architecture.json"
        },
        {
          "id": "html",
          "text": "iauteur.architecture.html"
        }
      ]
    },
    {
      "id": "receipt",
      "action": "run",
      "cmd": "node .claude/skills/archify/bin/archify.mjs validate architecture iauteur.architecture.json --quality showcase",
      "label": "the validation receipt",
      "focus": "terminal",
      "clearFirst": true,
      "marks": [
        {
          "id": "ok",
          "text": "ok architecture"
        },
        {
          "id": "checks",
          "text": "9 artifact checks"
        }
      ]
    },
    {
      "id": "ir",
      "action": "run",
      "cmd": "Get-Content iauteur.architecture.json | Select-Object -Skip 62 -First 30",
      "label": "the typed source the agent wrote",
      "focus": "terminal",
      "clearFirst": true,
      "marks": [
        {
          "id": "bake",
          "text": "bake-rec.mjs"
        },
        {
          "id": "lint",
          "text": "lint-spec.mjs"
        }
      ]
    }
  ]
}