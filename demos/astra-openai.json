{
  "slug": "astra-openai",
  "surface": "browser",
  "theme": "light",
  "viewport": {"width": 1600, "height": 900},
  "deviceScaleFactor": 4,
  "masterWidth": 0,
  "quality": 96,
  "crf": 18,
  "preset": "slow",
  "fps": 30,
  "profile": "out/rec-profile-web",
  "headless": false,
  "prep": {"url": "https://openai.com/index/gpt-6-astra/", "settleMs": 6000,
           "dismiss": ["Reject all cookies", "Accept all cookies", "Accept"]},
  "steps": [
    {"id": "open", "action": "expect", "text": "A new generation of intelligence",
     "label": "the announcement itself", "holdMs": 2000},
    {"id": "operator", "action": "scroll", "target": "text=The world’s best computer use model",
     "label": "how they describe it in their own words",
     "marks": [{"id": "cu", "text": "The world’s best computer use model"}],
     "holdMs": 2600},
    {"id": "critical", "action": "scroll", "target": "text=Critical threshold",
     "label": "the safety classification they gave it",
     "marks": [{"id": "crit", "text": "Critical threshold"}],
     "holdMs": 2600},
    {"id": "table", "action": "scroll", "target": "text=OSWorld 2.0 (v2026.08.08, offline set, partial score)",
     "label": "their own benchmark table",
     "marks": [{"id": "osworld", "text": "72.6%"}],
     "holdMs": 2600},
    {"id": "cad", "action": "scroll", "by": 380,
     "label": "the 3D result they lead with",
     "marks": [{"id": "cad", "text": "95.9%"}],
     "holdMs": 2400},
    {"id": "loses", "action": "scroll", "target": "text=Last Exam (w/ tools)",
     "label": "and the row where Astra does not win",
     "marks": [{"id": "astrahle", "text": "57.2%"}],
     "holdMs": 3000}
  ],
  "maxHoldMs": 1800
}
