{
  "slug": "fluidram-repos",
  "surface": "browser",
  "theme": "dark",
  "viewport": {"width": 1600, "height": 900},
  "fps": 30,
  "masterWidth": 3840,
  "deviceScaleFactor": 2.4,
  "prep": {"url": "https://github.com/adityarajIITj/adios/blob/0a85d38/README.md", "settleMs": 3500},
  "steps": [
    {"id": "adios-thesis", "action": "pause", "ms": 1200, "label": "the AdiOS thesis",
     "marks": [{"id": "thesis", "text": "What if memory behaved like a fluid"}]},
    {"id": "adios-three", "action": "scroll", "target": "text=The 3 Memory Breakthroughs", "settleMs": 1800, "label": "three memory ideas",
     "marks": [{"id": "threes", "text": "The 3 Memory Breakthroughs", "to": "co-designed primitives"}]},
    {"id": "fr-readme", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/README.md", "settleMs": 3500, "label": "the FluidRAM repo",
     "marks": [{"id": "frtitle", "text": "Linux Memory Subsystem Without Disk Swap"}]},
    {"id": "fr-table", "action": "scroll", "target": "text=Head-to-Head Comparison Summary", "settleMs": 1800, "label": "the claims table",
     "marks": [{"id": "multRow", "text": "Memory Density Multiplier", "to": "35.07x"},
               {"id": "zeroRows", "text": "Secondary Swap Writes", "to": "0 killed", "toCopy": 2}]},
    {"id": "gf-mul", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/driver/fluid_galois.c#L65-L70", "settleMs": 3500, "label": "the unused multiply",
     "marks": [{"id": "gfBody", "text": "static inline u8 gf_mul(u8 a, u8 b)", "to": "return gf_exp[gf_log[a] + gf_log[b]];"}]},
    {"id": "sparse-mode", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/driver/fluid_galois.c?view=sp#L134-L150", "settleMs": 3500, "label": "the sparse encoder",
     "marks": [{"id": "spc", "text": "Sparse Galois differential mode: non-zero count < 1024 (75% sparsity)"},
               {"id": "loopBody", "text": "Store (offset: 16-bit, value: 8-bit)", "to": "payload[p_idx++] = src[i];"}]},
    {"id": "crc-read", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/driver/fluid_galois.c?view=crc#L308-L311", "settleMs": 3000, "label": "checksum on every read",
     "marks": [{"id": "crcBody", "text": "Bit-exact verification", "to": "return -EILSEQ;"},
               {"id": "crcCmp", "text": "if (check_crc != hdr->crc16)"}]},
    {"id": "chart-literals", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/benchmark/generate_comparison_visuals.py#L58", "settleMs": 3000, "label": "the chart's values",
     "marks": [{"id": "mult", "text": "multipliers = [1.71, 4.12]"}]},
    {"id": "chart-latency", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/benchmark/generate_comparison_visuals.py?view=lat#L138", "settleMs": 3000, "label": "the latency bars",
     "marks": [{"id": "latLine", "text": "access_lat_us = [25100.0, 0.28]", "to": "Plain Linux 25.1 ms = 25,100 us vs FluidRAM 0.28 us"}]},
    {"id": "sim-zero", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/benchmark/fluidram_sim.py#L180-L185", "settleMs": 3000, "label": "faults fixed at zero",
     "marks": [{"id": "telBody", "text": "self.major_page_faults = 0 # STRICTLY 0 by invariant", "to": "self.oom_kills = 0"}]},
    {"id": "sim-latency", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/benchmark/plain_linux_sim.py#L133-L137", "settleMs": 3000, "label": "a fixed disk penalty",
     "marks": [{"id": "penBody", "text": "NVMe/SSD read penalty: 2.5ms latency", "to": "self.disk_io_wait_ms += 2.5"}]},
    {"id": "declared", "action": "goto", "url": "https://github.com/adityarajIITj/adios/blob/0a85d38/kernel/fluid_ram.py#L1262-L1269", "settleMs": 3500, "label": "how 35x is computed",
     "marks": [{"id": "resBody", "text": "Measure resident physical memory footprint", "to": "actual_resident_mb = (pinned_bytes / (1024.0 * 1024.0))"},
               {"id": "density", "text": "density_ratio = declared_workload_mb / max(0.1, actual_resident_mb)"}]},
    {"id": "qemu-zram", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/qemu/run_full_benchmark_suite.py#L41-L51", "settleMs": 3000, "label": "what the VM loads",
     "marks": [{"id": "insBody", "text": "insmod $M/kernel/lib/lz4/lz4_compress.ko", "to": "zram.ko num_devices=1"},
               {"id": "py", "text": "/usr/bin/python3 /guest_raw_benchmark.py"}]},
    {"id": "audit", "action": "goto", "url": "https://github.com/adityarajIITj/adios/blob/0a85d38/docs/architecture/reconstruction_adiOS.md#12-modeled-abstractions", "settleMs": 3500, "label": "the author's own audit",
     "marks": [{"id": "modeled", "text": "Modeled Abstractions"},
               {"id": "rowPair", "text": "1 GB FluidRAM Physical", "to": "Host Python bytearray"}]},
    {"id": "audit-tags", "action": "scroll", "target": "text=Tensegrity Folding Ratio", "settleMs": 1800, "label": "modeled and assumed values",
     "marks": [{"id": "tagRows", "text": "Linux OOM Murders", "to": "Modeled dynamic memory"}]},
    {"id": "locks", "action": "goto", "url": "https://github.com/adityarajIITj/fluidram/blob/bbecc61/driver/fluid_slab.c#L117-L135", "settleMs": 3000, "label": "two locks, one path",
     "marks": [{"id": "gfp", "text": "new_data = kmalloc(comp_len, GFP_KERNEL);"},
               {"id": "lockBody", "text": "memcpy(new_data, comp_buf, comp_len);", "to": "spin_lock(&pool->peer_pool->lock);"}]}
  ]
}
