 "steps": [
  {
   "id": "pad",
   "label": "one finger moves the cursor",
   "action": "gesture",
   "kind": "drag",
   "target": "#pad",
   "path": [
    [
     0.3,
     0.35
    ],
    [
     0.62,
     0.3
    ],
    [
     0.72,
     0.55
    ],
    [
     0.45,
     0.7
    ],
    [
     0.28,
     0.5
    ],
    [
     0.5,
     0.42
    ]
   ],
   "ms": 2600,
   "expect": "MOVE",
   "holdMs": 500
  },
  {
   "id": "tap",
   "label": "a tap is a click",
   "action": "gesture",
   "kind": "tap",
   "target": "#pad",
   "path": [
    [
     0.5,
     0.42
    ]
   ],
   "holdMs": 700
  },
  {
   "id": "deck",
   "label": "flip the pad to a keyboard",
   "action": "gesture",
   "kind": "tap",
   "target": "#btnDeck",
   "verify": false,
   "settleMs": 1000,
   "holdMs": 400
  },
  {
   "action": "gesture",
   "kind": "tap",
   "target": "#kbd2 button:text-is(\"H\")",
   "expect": "KEY",
   "settleMs": 260,
   "id": "deckH",
   "label": "type on the flipped pad"
  },
  {
   "action": "gesture",
   "kind": "tap",
   "target": "#kbd2 button:text-is(\"I\")",
   "expect": "KEY",
   "settleMs": 260,
   "id": "deckI",
   "label": "type on the flipped pad",
   "holdMs": 900
  },
  {
   "id": "deckback",
   "label": "and flip back",
   "action": "gesture",
   "kind": "tap",
   "target": "#btnDeck",
   "verify": false,
   "settleMs": 1000
  },
  {
   "id": "mouse",
   "label": "the mouse, drawn under the pad",
