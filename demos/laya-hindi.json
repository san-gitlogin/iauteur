{
  "slug": "laya-hindi",
  "surface": "vscode",
  "theme": "dark",
  "workspace": "laya-demo",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "deviceScaleFactor": 2.4,
  "masterWidth": 3840,
  "fps": 30,
  "terminalOnly": true,
  "maxHoldMs": 2400,
  "steps": [
    {
      "id": "route",
      "action": "run",
      "cmd": ".venv/bin/python route.py",
      "label": "the same question, two languages",
      "focus": "terminal",
      "clearFirst": true,
      "timeout": 900000,
      "expect": {
        "contains": "english"
      },
      "marks": [
        {
          "id": "hi",
          "text": "multilingual"
        },
        {
          "id": "why",
          "text": "non-Latin script"
        }
      ],
      "holdMs": 7000,
      "maxHoldMs": 7000
    }
  ]
}