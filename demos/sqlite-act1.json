{
  "slug": "sqlite-act1",
  "surface": "vscode",
  "theme": "dark",
  "workspace": "shop",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "fps": 30,
  "maxHoldMs": 700,
  "prep": {
    "files": {
      "schema.sql": "CREATE TABLE products (\n  id    INTEGER PRIMARY KEY,\n  name  TEXT    NOT NULL,\n  price REAL    NOT NULL\n) STRICT;\n",
      "seed.sql": "INSERT INTO products (name, price) VALUES\n  ('Mechanical keyboard',  89.00),\n  ('27-inch monitor',     240.00),\n  ('Desk lamp',            35.50),\n  ('USB-C hub',            45.00);\n"
    },
    "commands": [
      "Set-Alias sq '{{TOOLS}}/sqlite/sqlite3.exe'",
      "Remove-Item shop.db -ErrorAction SilentlyContinue"
    ],
    "openFile": "schema.sql",
    "requires": [
      {
        "tool": "sqlite3 3.53.4",
        "put": "tools/sqlite/sqlite3.exe",
        "why": "The course teaches 3.53.4. The machine SQLite here was 3.36.0, which has no STRICT tables — a lesson written from memory would have failed on camera (LAW 0m).",
        "from": "https://sqlite.org/download.html (precompiled binaries for your platform)"
      }
    ]
  },
  "steps": [
    {
      "id": "version",
      "action": "run",
      "cmd": "sq -version",
      "label": "the version we teach",
      "focus": "terminal",
      "holdMs": 900,
      "expect": {
        "contains": "3.53.4"
      },
      "marks": [
        {
          "id": "ver",
          "text": "3.53.4"
        }
      ]
    },
    {
      "id": "open-schema",
      "action": "openFile",
      "path": "schema.sql",
      "label": "four lines of table",
      "focus": "editor",
      "holdMs": 1400,
      "marks": [
        {
          "id": "strict",
          "text": ") STRICT;"
        },
        {
          "id": "notnull",
          "text": "name  TEXT    NOT NULL,"
        }
      ]
    },
    {
      "id": "create",
      "action": "run",
      "cmd": "sq shop.db \".read schema.sql\"",
      "label": "make the table",
      "focus": "terminal",
      "holdMs": 700
    },
    {
      "id": "strict-error",
      "action": "run",
      "cmd": "sq shop.db \"INSERT INTO products (name, price) VALUES ('Broken', 'not-a-number');\"",
      "label": "what STRICT actually buys you",
      "focus": "terminal",
      "holdMs": 1800,
      "expect": {
        "contains": "cannot store TEXT value",
        "exitCode": 1
      },
      "marks": [
        {
          "id": "err",
          "text": "cannot store TEXT value in REAL column products.price"
        }
      ]
    },
    {
      "id": "insert",
      "action": "run",
      "cmd": "sq shop.db \".read seed.sql\"",
      "label": "put four rows in",
      "focus": "terminal",
      "holdMs": 700
    },
    {
      "id": "select",
      "action": "run",
      "cmd": "sq shop.db -box -header \"SELECT * FROM products;\"",
      "label": "read them back",
      "focus": "terminal",
      "holdMs": 1300,
      "expect": {
        "contains": "Mechanical keyboard"
      },
      "marks": [
        {
          "id": "kb",
          "text": "Mechanical keyboard"
        },
        {
          "id": "mon",
          "text": "27-inch monitor"
        }
      ]
    },
    {
      "id": "where",
      "action": "run",
      "cmd": "sq shop.db -box -header \"SELECT name, price FROM products WHERE price < 60;\"",
      "label": "only some of them",
      "focus": "terminal",
      "holdMs": 1400,
      "expect": {
        "contains": "Desk lamp"
      },
      "marks": [
        {
          "id": "cheap",
          "text": "Desk lamp"
        }
      ]
    },
    {
      "id": "order",
      "action": "run",
      "cmd": "sq shop.db -box -header \"SELECT name, price FROM products ORDER BY price DESC LIMIT 3;\"",
      "label": "and in an order you choose",
      "focus": "terminal",
      "holdMs": 1400,
      "expect": {
        "contains": "27-inch monitor"
      },
      "marks": [
        {
          "id": "top",
          "text": "27-inch monitor"
        }
      ]
    },
    {
      "id": "update",
      "action": "run",
      "cmd": "sq shop.db -box -header \"UPDATE products SET price = 79.00 WHERE name = 'Mechanical keyboard' RETURNING name, price;\"",
      "label": "change one, and see what changed",
      "focus": "terminal",
      "holdMs": 1600,
      "expect": {
        "contains": "79.0"
      },
      "marks": [
        {
          "id": "newprice",
          "text": "79.0"
        }
      ]
    },
    {
      "id": "delete",
      "action": "run",
      "cmd": "sq shop.db -box -header \"DELETE FROM products WHERE name = 'Desk lamp'; SELECT changes() AS rows_deleted;\"",
      "label": "and take one away",
      "focus": "terminal",
      "holdMs": 1500,
      "expect": {
        "contains": "rows_deleted"
      },
      "marks": [
        {
          "id": "n",
          "text": "rows_deleted"
        }
      ]
    },
    {
      "id": "schema",
      "action": "run",
      "cmd": "sq shop.db \".schema products\"",
      "label": "the database describing itself",
      "focus": "terminal",
      "holdMs": 1600,
      "expect": {
        "contains": "CREATE TABLE products"
      },
      "marks": [
        {
          "id": "sch",
          "text": "CREATE TABLE products ("
        }
      ]
    },
    {
      "id": "just-a-file",
      "action": "run",
      "cmd": "Get-Item shop.db | Select-Object Name, Length",
      "label": "it is only a file",
      "focus": "terminal",
      "holdMs": 1600,
      "expect": {
        "contains": "shop.db"
      },
      "marks": [
        {
          "id": "file",
          "text": "shop.db"
        }
      ]
    }
  ]
}
