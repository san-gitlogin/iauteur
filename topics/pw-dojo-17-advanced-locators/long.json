          "contents": "Departure date",
          "blockedNote": "XPath cannot see inside",
          "verdict": "no special call needed",
          "caption": "everything pierces it. except XPath.",
          "color": "green",
          "atWord": 2.833,
          "probes": [
            {
              "label": "get_by_label(\"Departure\")",
              "title": "through",
              "sub": "straight in",
              "atWord": 5.667
            },
            {
              "label": "get_by_role(\"textbox\")",
              "title": "through",
              "sub": "also fine",
              "atWord": 10.333
            },
            {
              "label": "locator(\"input.date\")",
              "title": "through",
              "sub": "CSS pierces too",
              "atWord": 14.083
            },
            {
              "label": "get_by_placeholder(\"YYYY\")",
              "title": "through",
              "sub": "that one too",
              "atWord": 20.667
            },
            {
