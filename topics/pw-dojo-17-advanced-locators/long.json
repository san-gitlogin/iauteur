    {
      "id": "s18",
      "type": "RULE_TEST",
      "transition": "slide",
      "background": "zoneA",
      "narration": "One caution, and it catches people. Shadow DOM and iframes look similar from outside — both are a document tucked inside a document. They're not the same thing at all. Your locators pierce a shadow root without being asked. An iframe still needs frame locator, every single time, exactly like episode eleven.",
      "data": {
        "ruleTest": {
          "kicker": "do not mix these up",
          "rule": "shadow root pierces free. an iframe never does.",
          "okLabel": "just works",
          "noLabel": "needs a call",
          "caption": "they look alike. they behave nothing alike.",
