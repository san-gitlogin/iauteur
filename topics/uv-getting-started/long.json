    {
      "id": "s18",
      "type": "UV_STAGE",
      "narration": "One caution before you go. Some command names you'll read online simply don't exist. Shell completions don't come from uv completion. Upgrading one package isn't uv lock upgrade. And fixing your PATH isn't uv tool update shell. Each one is rejected outright, so check uv dash dash help before you search.",
      "transition": "push",
      "background": "zoneC",
      "data": {
        "uvStage": {
          "promptLabel": "uv",
          "cwd": "myapp",
          "headline": "Names people [get wrong]",
          "kind": "strict-gate",
          "layout": "terminal",
          "premise": "Three commands you will find written down. This is what uv answers.",
          "steps": [
            {
              "label": "uv completion zsh",
              "out": [
                "error: unrecognized subcommand 'completion'",
                "Usage: uv [OPTIONS] <COMMAND>"
              ],
              "detail": "use: uv generate-shell-completion zsh",
              "atWord": 13.667
