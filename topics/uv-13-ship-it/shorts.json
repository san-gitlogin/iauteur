      "transition": "morph",
      "background": "zoneA",
      "narration": "One flag before you publish, and it is easy to forget. Build with no-sources and uv resolves exactly as a stranger would — so a local path cannot escape into your package.",
      "data": {
        "uvStage": {
          "kind": "strict-gate",
          "color": "orange",
          "headline": "Build as a [stranger] would",
          "premise": "A local path or a git branch works on your machine and nowhere else.",
          "stageTitle": "--no-sources",
          "promptLabel": "you@laptop",
          "cwd": "~/work/invoice-app",
          "highlight": "--no-sources",
          "steps": [
            {
              "label": "uv build --no-sources",
              "out": [
                "x Failed to resolve: shared-utils",
                "  Caused by: not found in the package registry"
              ],
              "detail": "caught here, instead of by a stranger",
              "atWord": 13.75
            }
          ],
          "stage": [
            {
              "label": "shared-utils",
              "text": "local",
              "atWord": 7.25
            },
            {
              "label": "on your machine",
              "sub": "resolved from ../shared-utils",
              "detail": "works",
              "atWord": 10.5
            },
            {
              "label": "for anyone else",
              "sub": "no such folder exists",
              "detail": "fails",
              "atWord": 15.417
            }
          ]
        }
      },
      "durationFrames": 332,
      "audio": "audio/uv-13-short_s03.mp3",
      "timingSource": "tts"
