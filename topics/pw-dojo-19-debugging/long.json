    {
      "id": "s19",
      "type": "RECAP",
      "transition": "fade",
      "background": "zoneA",
      "narration": "Four lines, and then we're done. page dot pause freezes a live run with the browser still open. PWDEBUG equals one does the same thing without editing your test. Codegen hands you locators, not tests. And the ladder starts with reading the error, which is where most bugs already died.",
      "data": {
        "heading": "Debugging, in four lines",
        "points": [
          {
            "text": "pause() freezes a LIVE run",
            "atWord": 7.5
          },
          {
            "text": "PWDEBUG=1 — same, no edit",
            "atWord": 15
          },
          {
            "text": "codegen gives locators, not tests",
            "atWord": 21.75
          },
          {
            "text": "read the error first. always.",
            "atWord": 27.583
          }
        ]
      },
      "durationFrames": 522,
      "audio": "audio/pw-dojo-19-debugging_long_s19.mp3",
      "timingSource": "tts"
    },
    {
      "id": "s20",
      "type": "OUTRO_CTA",
