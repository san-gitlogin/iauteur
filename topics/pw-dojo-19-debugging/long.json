    {
      "id": "s15",
      "type": "ERROR_TRACE",
      "transition": "push",
      "background": "zoneB",
      "narration": "Rung one is simply to read the error. Properly, though — the whole message, not just the first line. Playwright's messages are unusually good: the locator Playwright used, what Playwright waited for, and what Playwright found instead. Most bugs die here.",
      "data": {
        "callStack": {
          "mode": "trace",
          "exception": "TimeoutError: locator.click: Timeout 30000ms",
          "culprit": 1,
          "atWord": 1,
          "frames": [
            {
              "fn": "test_checkout",
              "file": "test_pay.py",
              "line": 22,
              "sub": "your test, the click line"
            },
            {
              "fn": "waiting for the button",
              "sub": "name=\"Pay now\" — 30s",
              "color": "red"
            },
            {
              "fn": "found: name=\"Pay Now\"",
              "sub": "capital N. that is the bug",
              "color": "orange"
            }
          ]
        }
      },
      "durationFrames": 480,
      "audio": "audio/pw-dojo-19-debugging_long_s15.mp3",
      "timingSource": "tts"
    },
    {
