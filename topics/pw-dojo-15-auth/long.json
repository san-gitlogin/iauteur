          "askFor": "page",
          "crewLabel": "the context",
          "bodyLabel": "cookies live here",
          "teardownLabel": "and die here, normally",
          "caption": "your session lives in the dressing room",
          "color": "blue",
          "atWord": 2.583,
          "handoffAtWord": 21,
          "teardownAtWord": 33.75,
          "stages": [
            {
              "label": "browser",
              "sub": "the building",
              "atWord": 9.75
            },
            {
              "label": "context",
              "sub": "cookies + storage",
              "color": "blue",
              "atWord": 13.75
            },
            {
              "label": "page",
              "sub": "the stage",
              "atWord": 17
            }
          ]
        }
      },
      "durationFrames": 615,
      "audio": "audio/pw-dojo-15-auth_long_s09.mp3",
      "timingSource": "tts"
