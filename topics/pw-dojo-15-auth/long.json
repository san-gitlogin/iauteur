    {
      "id": "s17",
      "type": "CODE_RUN",
      "transition": "push",
      "background": "zoneA",
      "narration": "Here it is, both pieces. Scope equals session on the first one, so pytest runs that login exactly once and hangs onto whatever came back. Then the second fixture overrides the context arguments for every test, quietly slipping the stamp in on the way past. Somebody writing a test never has to know any of this exists.",
      "data": {
        "codeRun": {
          "filename": "conftest.py",
          "language": "py",
          "resultLabel": "how often it runs",
          "color": "orange",
          "atWord": 2.75,
          "caption": "once at the top, then every test",
          "lines": [
            {
              "text": "@pytest.fixture(scope=\"session\")",
              "detail": "session means once per run",
              "sub": "one login, whole suite",
              "label": "once",
              "atWord": 7.083
            },
            {
              "text": "def auth_state(browser):"
            },
            {
              "text": "    context.storage_state(",
              "detail": "save the stamp, hand back the path",
              "sub": "auth.json written",
              "label": "saved",
              "atWord": 19.167
            },
            {
              "text": "        path=\"auth.json\")"
            },
            {
              "text": "    return \"auth.json\"",
              "detail": "hand the path back to pytest",
              "sub": "cached for the whole session",
              "label": "kept",
              "atWord": 24.417
            },
            {
              "text": "@pytest.fixture"
            },
            {
              "text": "def browser_context_args(",
              "detail": "and slip it into every context",
              "sub": "every test, born stamped",
              "label": "each",
              "atWord": 33.083
            },
            {
              "text": "        browser_context_args, auth_state):"
            },
            {
              "text": "    return {**browser_context_args,"
            },
            {
              "text": "            \"storage_state\": auth_state}"
            }
          ]
        }
      },
      "durationFrames": 614,
      "audio": "audio/pw-dojo-15-auth_long_s17.mp3",
      "timingSource": "tts"
    },
