    {
      "id": "s02",
      "type": "DSA_TRACE_BSEARCH",
      "narration": "While left is less than or equal to right, keep guessing. That equals sign matters, because it lets the search look at a single remaining item. Mid equals left plus right, integer-divided by two. Zero plus nine is nine, and nine halved rounding down is four, because those two slashes mean divide and throw away the remainder. So we look at position four, which holds sixteen. Is sixteen our target? No, twenty-three is bigger. And because the list is sorted, everything left of sixteen is smaller still, so none of it can possibly be twenty-three.",
      "durationFrames": 995,
      "timingSource": "tts",
      "background": "zoneA",
      "data": {
        "dsaBsearch": {
          "headline": "Guess the [middle]",
          "color": "purple",
          "atWord": 1,
          "caption": "position four holds sixteen",
          "codeTitle": "binary_search.py",
          "premise": "A sorted row of numbers, and one target to find. It is higher-or-lower: every guess throws away half of whatever is still left.",
          "lines": [
            {
              "text": "def binary_search(nums, target):"
            },
            {
              "text": "    left = 0"
            },
            {
              "text": "    right = len(nums) - 1"
            },
            {
              "text": ""
            },
            {
              "text": "    while left <= right:",
              "detail": "Keep guessing while the range still holds something.",
              "atWord": 1
            },
            {
              "text": "        mid = (left + right) // 2",
              "detail": "The middle of what is left. // rounds down.",
              "atWord": 22.25
            },
            {
              "text": ""
            },
            {
              "text": "        if nums[mid] == target:",
              "detail": "Is the middle our target? Not this time.",
              "atWord": 56.417
            },
            {
              "text": "            return mid"
            },
            {
              "text": "        elif nums[mid] < target:"
            },
            {
              "text": "            left = mid + 1"
            },
            {
              "text": "        else:"
            },
            {
              "text": "            right = mid - 1"
            },
            {
              "text": ""
            },
            {
              "text": "    return -1"
            }
          ],
