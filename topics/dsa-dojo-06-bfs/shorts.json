    {
      "id": "s02",
      "type": "DSA_TRACE_GRID",
      "narration": "Now the neighbours. A connects to B and to C. For each one we ask whether we've seen it before, and neither of them has been. So we mark them visited, and push them onto the back of the queue, each carrying zero plus one, which is one stop. B goes on. C goes on. The queue now holds B and C, both at distance one. That's the first ring of the ripple, and nothing at distance two can be looked at until both of these have been.",
      "durationFrames": 799,
      "timingSource": "tts",
      "background": "zoneA",
      "data": {
        "dsaGrid": {
          "headline": "Everything [one stop away]",
          "color": "blue",
          "atWord": 1,
          "caption": "the first ring",
          "codeTitle": "bfs_shortest.py",
          "premise": "A subway map. Each circle is a station, each line a direct connection, and the badge on a station is how many stops it sits from A.",
          "lines": [
            {
              "text": "from collections import deque"
            },
            {
              "text": ""
            },
            {
              "text": "def bfs_shortest(graph, start, end):"
            },
            {
              "text": "    queue = deque([(start, 0)])"
            },
            {
              "text": "    visited = {start}"
            },
            {
              "text": ""
            },
            {
              "text": "    while queue:"
            },
            {
              "text": "        node, dist = queue.popleft()"
            },
            {
              "text": ""
            },
            {
              "text": "        if node == end:"
            },
            {
              "text": "            return dist"
            },
            {
              "text": ""
            },
            {
              "text": "        for neighbor in graph[node]:",
              "detail": "Look at everything this station connects to.",
              "atWord": 1
            },
            {
              "text": "            if neighbor not in visited:",
              "detail": "Have we already queued it?",
              "atWord": 7.333
            },
            {
              "text": "                visited.add(neighbor)",
              "detail": "Mark it, so nobody queues it again.",
              "atWord": 19.167
            },
            {
              "text": "                queue.append((neighbor, dist+1))",
              "detail": "Push it on the BACK, one stop further out.",
              "atWord": 22.833
            },
            {
              "text": ""
            },
            {
              "text": "    return -1"
            }
          ],
          "cells": [
