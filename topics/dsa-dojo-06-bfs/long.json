    {
      "id": "s04",
      "type": "DSA_TRACE_GRID",
      "narration": "You're standing at station A and you need to reach station E in as few stops as possible. That map connects A to B, A to C as well, B to D, C to D, and finally D to E. You could hop on any train and hope, and you might get there eventually by a scenic route. Breadth-first search is more disciplined, because it refuses to guess: it checks every station one stop away before it looks at any station two stops away.",
      "durationFrames": 760,
      "timingSource": "tts",
      "background": "zoneC",
      "data": {
        "dsaGrid": {
          "headline": "Five stops, [one map]",
          "color": "blue",
          "atWord": 1,
          "caption": "the network, laid out by distance",
          "codeTitle": "bfs_shortest.py",
          "premise": "A subway map. Each circle is a station, each line a direct connection, and the badge on a station is how many stops it sits from A.",
          "lines": [
            {
              "text": "from collections import deque"
            },
            {
              "text": ""
            },
            {
              "text": "def bfs_shortest(graph, start, end):"
            },
            {
              "text": "    queue = deque([(start, 0)])"
            },
            {
              "text": "    visited = {start}"
            },
            {
              "text": ""
            },
            {
              "text": "    while queue:"
            },
            {
              "text": "        node, dist = queue.popleft()"
            },
            {
              "text": ""
            },
            {
              "text": "        if node == end:"
            },
            {
              "text": "            return dist"
            },
            {
              "text": ""
            },
            {
              "text": "        for neighbor in graph[node]:"
            },
            {
              "text": "            if neighbor not in visited:"
            },
            {
              "text": "                visited.add(neighbor)"
            },
            {
              "text": "                queue.append((neighbor, dist+1))"
