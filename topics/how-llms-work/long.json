          {"icon": "lucide:eraser", "text": "No memory", "detail": "each chat starts fresh", "atWord": 16},
          {"icon": "lucide:calendar-off", "text": "Training cutoff", "detail": "blind to recent events", "atWord": 22}
        ]
      }
    },
    {
      "id": "s33",
      "type": "REVEAL",
      "narration": "So here's the truth to hold onto. A language model doesn't know things. It predicts what words most plausibly come next.",
      "durationFrames": 300,
      "timingSource": "estimated",
      "background": "zoneB",
      "transition": "zoom",
      "fx": "burst",
