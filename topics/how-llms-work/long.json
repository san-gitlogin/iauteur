    },
    {
      "id": "s32",
      "type": "LIST_BUILD",
      "narration": "A model predicts plausible text, not verified truth. So it can hallucinate confident nonsense, it has no memory between separate chats, and its knowledge stops at its training cutoff.",
      "durationFrames": 384,
      "timingSource": "estimated",
      "background": "zoneA",
      "transition": "fade",
      "data": {
