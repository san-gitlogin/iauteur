    {
      "id": "s18",
      "type": "RULE_TEST",
      "transition": "slide",
      "background": "zoneB",
      "narration": "There's a line here, and it's worth knowing where it sits. Setting things up? Phone, every time. Checking a JSON field came back right? Phone again. But whether the delete button is actually clickable on a narrow screen — no phone call on earth answers that. Your users don't send HTTP requests. They click things.",
      "data": {
        "ruleTest": {
          "kicker": "know the line",
          "rule": "the API is for setup and data. the UI is for what users do.",
          "okLabel": "phone it",
          "noLabel": "open the page",
          "caption": "users click. they do not send requests.",
          "color": "orange",
          "atWord": 2.833,
          "cases": [
            {
              "text": "seed five users before the test",
              "title": "ok",
              "sub": "scenery, not the subject",
              "atWord": 13.667
            },
            {
              "text": "assert the JSON field came back",
              "title": "ok",
              "sub": "no DOM involved at all",
              "atWord": 20.917
            },
            {
              "text": "clean the seeded rows up after",
              "title": "ok",
              "sub": "teardown is scenery too",
              "atWord": 26.417
            },
            {
              "text": "is the Delete button clickable?",
              "title": "no",
              "sub": "only a real browser knows",
              "atWord": 32.75
            }
          ]
        }
      },
      "durationFrames": 619,
      "audio": "audio/pw-dojo-16-api-testing_long_s18.mp3",
      "timingSource": "tts"
    },
    {
      "id": "s19",
      "type": "RECAP",
      "transition": "fade",
      "background": "zoneA",
      "narration": "Three lines to walk away with. Playwright speaks HTTP with no browser at all, and that route runs about fifty times faster than the one you're used to. Set your world up over the phone, every time, because the setup was never the thing you were testing. Then open the browser for the one bit that actually is.",
      "data": {
