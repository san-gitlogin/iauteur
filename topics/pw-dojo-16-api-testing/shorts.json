      "transition": "push",
      "background": "zoneA",
      "narration": "You ask Playwright for a request context instead of a browser. Give that a base URL, so you're not retyping the host everywhere. Then get, post, whatever you need — and a plain assert does fine here, because there's no DOM to sit around waiting on.",
      "data": {
        "codeRun": {
          "filename": "test_api.py",
          "language": "py",
          "resultLabel": "no browser",
          "color": "blue",
          "atWord": 2.5,
          "caption": "HTTP, and nothing else",
          "lines": [
            {
              "text": "ctx = playwright.request.new_context(",
              "detail": "speaks HTTP, not clicks",
              "sub": "no browser launches",
              "label": "http",
              "atWord": 6.167
            },
            {
              "text": "    base_url=\"https://api.github.com\")"
