   "id": "s01",
   "type": "MCP_API_ANATOMY",
   "durationFrames": 300,
   "background": "zoneA",
   "narration": "proof fixture",
   "data": {
    "mcpApi": {
     "headline": "The call, [taken apart]",
     "caption": "one API call",
     "premise": "Claude is an API. You send messages, you get a message back.",
     "color": null,
     "atWord": 1,
     "cells": [
      {
       "label": "model=",
       "sub": "claude-sonnet-4-0 \u2014 fast and affordable",
       "atWord": 2
      },
      {
       "label": "max_tokens=",
       "sub": "1024 \u2014 the ceiling on the reply",
       "atWord": 4
      },
      {
       "label": "messages=[\u2026]",
       "sub": "the whole conversation so far, each with a role",
       "atWord": 6
      }
     ],
     "lines": [
      {
       "text": "from anthropic import Anthropic"
      },
      {
       "text": "client = Anthropic()",
       "detail": "Reads ANTHROPIC_API_KEY from your environment.",
       "atWord": 2
      },
      {
       "text": "message = client.messages.create(",
       "detail": "The core call. Everything else is arguments.",
       "atWord": 4
      },
      {
       "text": "    model=\"claude-sonnet-4-0\","
      },
      {
       "text": "    max_tokens=1024,"
      },
      {
       "text": "    messages=[{\"role\":\"user\",\"content\":\"What is MCP?\"}],"
      },
      {
       "text": ")"
      }
     ],
     "codeTitle": "server.py"
    }
   }
  },
  {
   "id": "s02",
   "type": "MCP_CONTROL",
   "durationFrames": 300,
   "background": "zoneA",
   "narration": "proof fixture",
   "data": {
    "mcpControl": {
     "headline": "Who pulls [the trigger]",
     "caption": "the three primitives",
     "premise": "An MCP server exposes exactly three things. The only question that separates them is who decides when it runs.",
     "color": null,
     "atWord": 1,
     "cells": [
      {
       "label": "Tools",
       "sub": "functions the model chooses to call",
       "owner": "ai",
       "atWord": 2
      },
      {
       "label": "Resources",
       "sub": "data your app fetches for context",
       "owner": "code",
       "atWord": 5
      },
      {
       "label": "Prompts",
       "sub": "workflows the person triggers",
       "owner": "user",
       "atWord": 8
      }
     ]
    }
   }
  },
  {
   "id": "s03",
   "type": "MCP_WIRE",
   "durationFrames": 300,
   "background": "zoneA",
   "narration": "proof fixture",
   "data": {
    "mcpWire": {
     "headline": "Every arrow is [one message]",
     "caption": "the handshake",
     "premise": "The client is your app. The server is somebody else's code. Each arrow is one JSON-RPC message.",
     "color": null,
     "atWord": 1,
     "cells": [
      {
       "label": "tools/list",
       "sub": "what can you do?",
       "dir": "out",
       "atWord": 2,
       "out": [
        "{\"method\":\"tools/list\",\"id\":1}"
       ]
      },
      {
       "label": "3 tools",
       "sub": "read_note \u00b7 edit_note \u00b7 list_notes",
       "dir": "back",
       "atWord": 5,
       "out": [
        "{\"result\":{\"tools\":[",
        "  {\"name\":\"read_note\", \u2026},",
        "  {\"name\":\"edit_note\", \u2026}]}}"
       ]
      },
      {
       "label": "tools/call",
       "sub": "run read_note with note_id=todo.md",
       "dir": "out",
       "atWord": 8,
       "out": [
        "{\"method\":\"tools/call\",",
        " \"params\":{\"name\":\"read_note\",",
        "  \"arguments\":{\"note_id\":\"todo.md\"}}}"
       ]
      }
     ],
     "lines": [
      {
       "text": "tools = await client.list_tools()",
       "detail": "Ask the server what it can do.",
       "atWord": 2
      },
      {
       "text": "result = await client.call_tool(",
       "detail": "Run one of them by name.",
       "atWord": 8
      },
      {
       "text": "    \"read_note\", {\"note_id\": \"todo.md\"})"
      }
     ],
     "codeTitle": "server.py",
     "ends": [
      {
       "label": "CLIENT"
      },
      {
       "label": "SERVER"
      }
     ]
    }
   }
  },
