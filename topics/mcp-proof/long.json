       "out": [
        "Buy groceries, call mom, fix the bug"
       ]
      }
     ],
     "lines": [
      {
       "text": "@mcp.resource(\"notes://all\")",
       "detail": "Static: no parameters.",
       "atWord": 2
      },
      {
       "text": "def list_all_notes():"
      },
      {
       "text": "    return list(notes.keys())"
      },
      {
       "text": ""
      },
      {
       "text": "@mcp.resource(\"notes://{id}\")",
       "detail": "The braced part becomes an argument.",
       "atWord": 5
      },
      {
       "text": "def get_note(id: str):"
      },
      {
       "text": "    return notes[id]"
      }
     ],
