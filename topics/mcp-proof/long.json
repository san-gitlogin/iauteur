  {
   "id": "s05",
   "type": "MCP_LOOP",
   "durationFrames": 300,
   "background": "zoneA",
   "narration": "proof fixture",
   "data": {
    "mcpLoop": {
     "headline": "Until Claude [stops asking]",
     "caption": "the agentic loop",
     "premise": "Your app sits between Claude and the server, relaying until Claude has no more tool calls to make.",
     "color": null,
     "atWord": 1,
     "cells": [
      {
       "label": "send tools",
       "sub": "+ the question",
       "atWord": 2
      },
      {
       "label": "tool_use",
       "sub": "Claude asks",
       "atWord": 4
      },
      {
       "label": "call_tool",
       "sub": "you run it",
       "atWord": 6
      },
      {
       "label": "send result",
       "sub": "back to Claude",
       "atWord": 8
      },
      {
       "label": "no tool_use",
       "sub": "done",
       "text": "exit",
       "atWord": 10
      }
     ],
     "lines": [
      {
       "text": "while True:",
       "detail": "The heartbeat of every MCP app.",
       "atWord": 2
      },
      {
       "text": "    reply = claude(messages, tools)"
      },
      {
       "text": "    if not reply.tool_use: break",
       "detail": "The ONLY exit. Not a counter, not a keypress.",
       "atWord": 10
      },
      {
       "text": "    out = await client.call_tool(...)",
       "atWord": 6
      },
      {
       "text": "    messages.append(out)",
       "atWord": 8
      }
     ],
     "codeTitle": "server.py"
    }
   }
  },
