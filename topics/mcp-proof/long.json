     "lines": [
      {
       "text": "@mcp.tool()"
      },
      {
       "text": "async def summarize(text, ctx: Context):",
       "detail": "ctx is the server's walkie-talkie back to the client.",
       "atWord": 2
      },
      {
       "text": "    result = await ctx.session.create_message(",
       "detail": "Please call an LLM for me.",
