    {
      "id": "s14",
      "type": "CODE_WINDOW",
      "transition": "push",
      "background": "zoneB",
      "narration": "Here's nearly all of it — one more line to come. Save this as dot github, workflows, tests dot yml. Most of it is boilerplate you'll copy from job to job forever, and I'd not pretend otherwise. Check out the code, install things.",
      "data": {
        "code": {
          "filename": ".github/workflows/tests.yml",
          "language": "bash",
          "runLabel": "commit this once",
          "atWord": 1.833,
          "lines": [
            {
              "text": "name: Playwright Tests"
            },
            {
              "text": "on: [push, pull_request]"
            },
            {
              "text": "jobs:"
            },
            {
              "text": "  test:"
            },
            {
              "text": "    runs-on: ubuntu-latest"
            },
            {
              "text": "    steps:"
            },
            {
              "text": "      - uses: actions/checkout@v4"
            },
            {
              "text": "      - uses: actions/setup-python@v5"
            },
            {
              "text": "      - run: pip install pytest-xdist"
            },
            {
              "text": "      - run: playwright install --with-deps"
            },
            {
              "text": "      - run: pytest -n auto \\"
            },
            {
              "text": "          --tracing retain-on-failure"
            }
          ]
        }
      },
      "durationFrames": 455,
      "audio": "audio/pw-dojo-18-parallel-ci_long_s14.mp3",
      "timingSource": "tts"
    },
    {
      "id": "s15",
      "type": "TERMINAL_SESSION",
      "transition": "push",
      "background": "zoneA",
      "narration": "Push that, and from now on every single push gets checked. Green tick, three minutes, nobody had to remember anything. Somebody opens a pull request at eleven at night and the suite runs anyway.",
      "data": {
        "terminal": {
