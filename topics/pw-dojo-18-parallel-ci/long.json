    {
      "id": "s10",
      "type": "ORDER_ROULETTE",
      "transition": "zoom",
      "background": "zoneB",
      "narration": "Suppose test_edit_profile quietly assumes test_create_profile already ran. Sequentially that's fine. Nobody notices. Under four workers? Workers grab tests independently, so there's no order at all. Run one passes. Run two fails, because edit went first and there was nothing to edit. Run three fails differently. Run four passes again. This isn't broken. It's a coin flip.",
      "data": {
        "orderRoulette": {
          "dependency": "test_edit assumes test_create ran",
          "producer": "test_create_profile",
          "consumer": "test_edit_profile",
          "verdict": "not broken. a coin flip.",
          "fix": "each test builds its own world",
          "caption": "workers grab tests. there is no order.",
          "color": "red",
          "atWord": 3.333,
          "runs": [
            {
              "label": "run 1",
              "text": "gw0: create → gw1: edit",
              "title": "pass",
              "sub": "lucky ordering",
