    {
      "id": "s16",
      "type": "CODE_RUN",
      "transition": "push",
      "background": "zoneB",
      "narration": "Now, four lines do the actual work here. With-deps installs the Linux libraries the browser needs, which everybody forgets and then loses an hour to. Dash n auto runs it in parallel, on however many cores the runner gave you. Retain-on-failure keeps a trace, but only for tests that broke. And upload-artifact takes that trace home with you. Which sounds like housekeeping, and absolutely is not, for a reason I'll show you in about ten seconds.",
      "data": {
        "codeRun": {
          "filename": "the three that matter",
          "language": "bash",
          "resultLabel": "what each does",
          "color": "green",
          "atWord": 2.667,
          "caption": "the rest is boilerplate. these are not.",
          "lines": [
            {
              "text": "# the four that actually matter",
              "detail": "the rest you will copy forever",
              "sub": "these four you should know",
              "label": "four",
              "atWord": 5.083
            },
            {
              "text": "playwright install --with-deps chromium",
              "detail": "browsers AND the Linux libs",
              "sub": "the bit everyone forgets",
              "label": "deps",
              "atWord": 13.333
            },
            {
              "text": ""
            },
            {
              "text": "pytest -n auto \\",
              "detail": "one worker per core it gives you",
              "sub": "you never know the hardware",
              "label": "auto",
              "atWord": 33.167
            },
            {
              "text": "    --tracing retain-on-failure",
              "detail": "record, keep only the failures",
              "sub": "green runs cost you nothing",
              "label": "trace",
              "atWord": 44.667
            },
            {
              "text": "  - uses: actions/upload-artifact@v4",
              "detail": "and take the trace home with you",
              "sub": "or it dies with the runner",
              "label": "keep",
              "atWord": 51.25
            }
          ]
        }
      },
      "durationFrames": 773,
      "audio": "audio/pw-dojo-18-parallel-ci_long_s16.mp3",
      "timingSource": "tts"
    },
