    {
      "id": "s11",
      "type": "QUIZ_CARD",
      "transition": "dip",
      "background": "zoneA",
      "narration": "Quick one. test_edit_profile assumes test_create_profile ran first. You add dash n four. What happens? Ready? It's C. Random failures — those two land on any worker, in any order.",
      "data": {
        "quiz": {
          "question": "A chained test, run with -n 4. What happens?",
          "options": [
            {
              "text": "pytest works out the order"
            },
            {
              "text": "Works fine, same as before"
            },
            {
              "text": "Random failures, any order"
            },
            {
              "text": "The suite just runs slower"
            }
          ],
          "answerIndex": 2,
          "revealAtWord": 19.417,
          "why": "Workers grab tests independently. Nothing guarantees an order.",
          "atWord": 1
        }
      },
      "durationFrames": 480,
      "audio": "audio/pw-dojo-18-parallel-ci_long_s11.mp3",
      "timingSource": "tts"
