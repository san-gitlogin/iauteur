          "items": [
            "test_login",
            "test_checkout",
            "test_search",
            "test_profile"
          ],
          "beforeLabel": "10m12s, one file",
          "afterLabel": "2m41s, four workers",
          "note": "only because tests are isolated",
          "caption": "the work did not get faster. it got spread.",
          "color": "green",
          "atWord": 3.417,
          "lanes": [
