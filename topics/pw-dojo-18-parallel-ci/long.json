    {
      "id": "s06",
      "type": "TERMINAL_SESSION",
      "transition": "push",
      "background": "zoneB",
      "narration": "Getting it is one line. Install pytest-xdist, and you've got a new flag. Dash n four gives you four worker processes. Dash n auto gives you one per CPU core, which is the one I'd reach for on a machine you don't control — your laptop and the build server won't have the same number of cores.",
      "data": {
        "terminal": {
          "promptLabel": "you@laptop",
          "cwd": "~/dojo",
          "atWord": 2.5,
          "commands": [
            {
              "cmd": "pip install pytest-xdist",
              "output": [
                "Successfully installed pytest-xdist-3.5.0"
              ],
              "exitCode": 0,
              "atWord": 6.083
            },
            {
              "cmd": "pytest -n 4",
              "output": [
                "# four worker processes"
              ],
              "exitCode": 0,
              "atWord": 13.417
            },
            {
              "cmd": "pytest -n auto",
              "output": [
                "# one worker per CPU core"
              ],
              "exitCode": 0,
              "atWord": 19.25
            }
          ]
