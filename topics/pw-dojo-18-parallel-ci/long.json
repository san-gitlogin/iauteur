            {
              "label": "run 3",
              "text": "gw1: edit · gw3: create",
              "title": "fail",
              "sub": "same instant, no row",
              "atWord": 33.75
            },
            {
              "label": "run 4",
              "text": "gw3: create → gw2: edit",
              "title": "pass",
              "sub": "lucky again, somehow",
              "atWord": 37.25
            }
          ],
          "verdictAtWord": 44.25
        }
      },
      "durationFrames": 807,
      "audio": "audio/pw-dojo-18-parallel-ci_long_s10.mp3",
      "timingSource": "tts"
