      "type": "HOOK",
      "transition": "dip",
      "background": "zoneA",
      "narration": "The iPhone Duo folds, and its selfie camera hides underneath the screen. Really.",
      "data": {
        "headline": "iPhone Duo",
        "subtext": "Apple's first foldable iPhone",
        "kicker": "September 2026",
        "variant": "plaque",
        "atWord": 4.917
