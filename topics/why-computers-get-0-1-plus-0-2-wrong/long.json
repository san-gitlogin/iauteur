    {
      "id": "s03",
      "type": "CONCEPT_DIAGRAM",
      "narration": "Here's the thing. Try writing one third as a decimal — you get 0.333 running on forever, so you stop and round somewhere.",
      "durationFrames": 306,
      "timingSource": "estimated",
      "background": "zoneC",
      "transition": "iris",
      "data": {
        "headline": "One third [never ends]",
