            "atWord": 10
          }
        ]
      }
    },
    {
      "id": "s04",
      "type": "FORMULA",
      "narration": "Computers hit the exact same wall, just in binary. Ask for one tenth, and base two can only spell it as a fraction that repeats forever.",
      "durationFrames": 342,
      "timingSource": "estimated",
      "background": "zoneA",
      "transition": "push",
      "data": {
        "formula": {
          "parts": [
            {
              "text": "0.1",
              "kind": "num",
              "sub": "10"
            },
            {
              "text": "=",
              "kind": "op"
            },
            {
              "text": "0.00011001…",
              "kind": "num",
              "sub": "2",
              "highlight": true
            }
          ],
          "label": "One tenth repeats forever in binary — like 1/3 in decimal"
        }
      }
    },
    {
      "id": "s05",
      "type": "STAT_CALLOUT",
      "narration": "So it does what you would do — it rounds. A standard number gets only 52 bits to store the fraction, and the rest is chopped off.",
      "durationFrames": 354,
      "timingSource": "estimated",
      "background": "zoneB",
      "transition": "dip",
      "data": {
        "value": 52,
        "label": "bits of fraction, then it rounds",
        "atWord": 15,
        "source": "IEEE 754 double precision"
      }
    },
    {
      "id": "s06",
      "type": "STEP_FLOW",
      "narration": "Watch it happen. It rounds 0.1, rounds 0.2, then adds those two slightly-off values — and the tiny errors stack into that weird trailing four.",
      "durationFrames": 330,
      "timingSource": "estimated",
      "background": "zoneC",
      "transition": "zoom",
      "data": {
        "steps": [
