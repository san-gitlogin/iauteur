    {
      "id": "s12",
      "type": "DSA_SIGNALS",
      "narration": "When a dynamic programming question lands and your mind goes blank, do these in order. Brute force the answers for n equals one, two, three and four by hand. Then ask how each relates to the ones before it, because that relationship is your recurrence. Pin down the base cases. Write the loop upward from them. And only then ask whether the array can shrink to a couple of variables. Order matters, because optimising space before the recurrence is correct is how people burn twenty minutes and end up with neither.",
      "durationFrames": 907,
      "timingSource": "tts",
      "background": "zoneB",
      "data": {
        "dsaSignals": {
          "headline": "How to actually [find it]",
          "color": "green",
          "atWord": 1,
          "caption": "the recipe, in order",
          "premise": "Words lifted straight out of the question, and the pattern each one points at. Red means the signal rules this pattern OUT.",
          "cells": [
            {
              "label": "1 · brute force small n",
              "sub": "by hand, on paper",
              "atWord": 12.167
            },
            {
