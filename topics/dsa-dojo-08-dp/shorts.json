    {
      "id": "s02",
      "type": "DSA_TRACE_DP",
      "narration": "Prev2 equals one and prev1 equals two, and those are two sticky notes: prev2 remembers the stair two below, and prev1 remembers the stair one below. Why two notes and not a whole table? Because the recurrence never looks back further than two places, so anything older can be thrown away. Most people write this with a full array first, which is fine, but noticing you need only two variables is what drops the space to constant.",
      "durationFrames": 793,
      "timingSource": "tts",
      "background": "zoneA",
      "data": {
        "dsaDp": {
          "headline": "Two [sticky notes]",
          "color": "green",
          "atWord": 1,
          "caption": "all the memory you need",
          "codeTitle": "climb_stairs.py",
          "premise": "A staircase of five steps. Each box is one stair, and the number written in it is how many different ways there are to reach that stair.",
          "lines": [
            {
              "text": "def climb_stairs(n):"
            },
            {
              "text": "    if n <= 2: return n"
            },
            {
              "text": ""
            },
            {
              "text": "    prev2, prev1 = 1, 2",
              "detail": "Two sticky notes: one stair back, and two stairs back.",
              "atWord": 1
            },
            {
              "text": ""
            },
            {
              "text": "    for i in range(3, n + 1):"
            },
            {
              "text": "        current = prev1 + prev2"
            },
            {
              "text": "        prev2 = prev1"
            },
            {
              "text": "        prev1 = current"
            },
            {
              "text": ""
            },
            {
              "text": "    return prev1"
            }
          ],
          "cells": [
