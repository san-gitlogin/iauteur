    {
      "id": "s06",
      "type": "CODE_RUN",
      "transition": "push",
      "background": "zoneA",
      "narration": "So what can you do with a group? Three things, and we will take them one at a time. The first tells you how many there are. The second grabs every label in one go. And the third hands you a list you can loop over.",
      "data": {
        "codeRun": {
          "filename": "crowd.py",
          "language": "py",
          "resultLabel": "what it prints",
          "caption": "three tools, one group",
          "color": "orange",
          "atWord": 2.25,
          "lines": [
            {
              "text": "items = page.get_by_role(\"listitem\")"
            },
            {
              "text": ""
            },
            {
              "text": "print(items.count())",
              "detail": "how many are there right now",
              "sub": "5",
              "label": "stdout",
              "atWord": 9.417
            },
            {
              "text": "print(items.all_inner_texts())",
              "detail": "every label, in one go",
              "sub": "['Buy milk', 'Walk dog', ...]",
              "label": "stdout",
              "atWord": 15.833
            },
            {
              "text": ""
            },
            {
              "text": "for item in items.all():",
              "detail": "a list you can loop over",
              "sub": "5 single locators",
              "label": "loop",
              "atWord": 22.25
            },
            {
              "text": "    print(item.inner_text())"
            }
          ]
        }
      },
      "durationFrames": 377,
      "audio": "audio/pw-dojo-10-many-elements_long_s06.mp3",
      "timingSource": "tts"
