      "type": "RULE_TEST",
      "transition": "slide",
      "background": "zoneA",
      "narration": "One warning before we move on. If you want to check how many there are, do not use count yourself. Use expect. One of these asks once and gives up. The other keeps checking for five seconds.",
      "data": {
        "ruleTest": {
          "kicker": "the safe way",
          "rule": "check a size with expect, never with count()",
          "okLabel": "retries",
          "noLabel": "asks once",
