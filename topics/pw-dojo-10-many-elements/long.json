              "text": "assert items.count() == 5",
              "title": "no",
              "sub": "asks once, then gives up",
              "atWord": 15.667
            },
            {
              "text": "expect(items).to_have_count(5)",
              "title": "ok",
              "sub": "keeps checking for 5s",
              "atWord": 20.5
