    {
      "id": "s11",
      "type": "CODE_RUN",
      "transition": "push",
      "background": "zoneA",
      "narration": "Here it is in code. Read the middle part out loud, like a sentence. Among all the list items, keep the one containing the words walk dog. Then click the Delete button inside that one. There is also a second kind of filter, and it keeps rows by what they hold inside them, like a ticked checkbox.",
      "data": {
        "codeRun": {
          "filename": "filter.py",
          "language": "py",
          "resultLabel": "what is left",
          "caption": "find the row, then act within it",
          "color": "orange",
          "atWord": 2.333,
          "lines": [
            {
              "text": "rows = page.get_by_role(\"listitem\")"
            },
            {
              "text": ""
            },
            {
              "text": "dog_row = rows.filter(",
              "detail": "keep only rows with that text",
              "sub": "1 row left, out of 5",
              "label": "rows",
              "atWord": 8.5
            },
            {
              "text": "    has_text=\"Walk dog\")"
            },
            {
              "text": "dog_row.get_by_role(\"button\",",
              "detail": "then act INSIDE that row",
              "sub": "one Delete, the right one",
              "label": "click",
              "atWord": 19.5
            },
            {
              "text": "    name=\"Delete\").click()"
            },
            {
              "text": ""
            },
            {
              "text": "done = rows.filter(",
              "detail": "or keep rows by what they hold",
              "sub": "every row with a tick",
              "label": "rows",
              "atWord": 28.417
            },
            {
              "text": "    has=page.get_by_role("
            },
            {
              "text": "        \"checkbox\", checked=True))"
            }
          ]
        }
      },
      "durationFrames": 490,
      "audio": "audio/pw-dojo-10-many-elements_long_s11.mp3",
      "timingSource": "tts"
