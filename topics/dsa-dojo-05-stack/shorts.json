    {
      "id": "s02",
      "type": "DSA_TRACE_STACK",
      "narration": "First character: an open brace. Is that an opener? It is. Nothing gets checked here, because openers never need checking, and an opener is really just a promise that something will have to close further along. Stack dot append puts it on top. In Python append adds to the end of a list, and because we always look at the end, the end behaves like the top of a pile. One layer deep, and the promise is recorded. That's all an opener ever does in this algorithm.",
      "durationFrames": 834,
      "timingSource": "tts",
      "background": "zoneA",
      "data": {
        "dsaStack": {
          "headline": "An opener goes [on top]",
          "color": "red",
          "atWord": 1,
          "caption": "one layer deep",
          "codeTitle": "valid_parentheses.py",
          "premise": "Checking brackets, using the getting-dressed rule: each box is one character of the input, and the stack beside it holds what still needs closing — last on, first off.",
          "lines": [
            {
              "text": "def valid_parentheses(s):"
            },
            {
              "text": "    stack = []"
            },
            {
              "text": "    pairs = {')':'(', '}':'{', ']':'['}"
            },
            {
              "text": ""
            },
            {
              "text": "    for char in s:"
            },
            {
              "text": "        if char in '({[':",
              "detail": "Is this an opener?",
              "atWord": 3.917
            },
            {
              "text": "            stack.append(char)",
              "detail": "Then put it on top of the pile.",
              "atWord": 28
            },
            {
              "text": "        elif char in ')}]':"
            },
            {
              "text": "            if not stack:"
            },
            {
              "text": "                return False"
            },
            {
              "text": "            if stack[-1] != pairs[char]:"
            },
            {
              "text": "                return False"
            },
            {
              "text": "            stack.pop()"
            },
            {
              "text": ""
            },
            {
              "text": "    return len(stack) == 0"
