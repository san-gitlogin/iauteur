    {
      "id": "s02",
      "type": "DSA_TRACE_INTERVALS",
      "narration": "The diary is sorted by start time, and the next booking is two to six. Does its start come before the current block ends? Two is less than or equal to three, so yes, they overlap. So we stretch the block's end to whichever end is later, which is six. One to three and two to six have become one to six. One block now covers both meetings, and notice we never created anything new, we only widened what was already there.",
      "durationFrames": 769,
      "timingSource": "tts",
      "background": "zoneA",
      "data": {
        "dsaIntervals": {
          "headline": "Overlap, so [merge]",
          "color": "orange",
          "atWord": 1,
          "caption": "two into one",
          "codeTitle": "merge_intervals.py",
          "premise": "A meeting-room diary. Each bar is one booking drawn on a shared timeline, so two bars that overlap are two meetings that clash.",
          "lines": [
            {
              "text": "def merge_intervals(intervals):"
            },
            {
              "text": "    intervals.sort(key=lambda x: x[0])"
            },
            {
              "text": "    merged = [intervals[0]]"
            },
            {
              "text": ""
            },
            {
              "text": "    for start, end in intervals[1:]:",
              "detail": "Walk the rest, in sorted order.",
              "atWord": 1
            },
            {
              "text": "        if start <= merged[-1][1]:",
              "detail": "Does this one start before the block ends?",
              "atWord": 11.417
            },
            {
              "text": "            merged[-1][1] = max(merged[-1][1], end)",
              "detail": "Then stretch the block to the later end.",
              "atWord": 27.333
            },
            {
              "text": "        else:"
            },
            {
              "text": "            merged.append([start, end])"
            },
            {
              "text": ""
            },
            {
              "text": "    return merged"
            }
          ],
