    {
      "id": "s17",
      "type": "CHAPTER",
      "transition": "wipe",
      "background": "zoneC",
      "narration": "Everything so far assumed you know where you are. This next set is for the opposite: a project somebody else wrote, which you now have to find your way around.",
      "data": {
        "chapter": {
          "number": "03",
          "title": "Navigating",
          "subtitle": "someone else’s project"
