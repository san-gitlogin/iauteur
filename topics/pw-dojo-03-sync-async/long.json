      },
      "durationFrames": 421,
      "audio": "audio/pw-dojo-03-sync-async_long_s17.mp3",
      "timingSource": "tts"
    },
    {
      "id": "s18",
      "type": "STICKY_NOTE",
      "transition": "slide",
      "background": "zoneB",
      "narration": "Worth keeping beside you the first few times you read somebody else's Playwright code online, because you will meet both flavors within about ten minutes of searching, and mixing them up produces errors that make very little sense.",
      "data": {
        "stickyNote": {
          "headline": "Four tells",
          "color": "blue",
          "notes": [
            {
              "title": "SPOT THE ASYNC",
              "tag": "memory hook",
              "body": "async_api import. async def. await everywhere. asyncio.run(). See those four? You are reading async code.",
              "highlight": "await everywhere",
              "asset": "lucide:search",
              "atWord": 11.167
            }
          ]
        }
      },
      "durationFrames": 353,
      "audio": "audio/pw-dojo-03-sync-async_long_s18.mp3",
      "timingSource": "tts"
    },
    {
      "id": "s19",
      "type": "CHAPTER",
      "transition": "wipe",
      "background": "zoneA",
      "narration": "Which leaves the only question that really matters to you right now.",
      "data": {
        "chapter": {
          "number": "04",
