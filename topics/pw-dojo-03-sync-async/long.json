      "durationFrames": 398,
      "audio": "audio/pw-dojo-03-sync-async_long_s22.mp3",
      "timingSource": "tts"
    },
    {
      "id": "s23",
      "type": "STAT_CALLOUT",
      "transition": "morph",
      "background": "zoneA",
      "narration": "The other place async makes sense is when Playwright goes inside an app that is already async, like a web server or a chat bot. But here is the number that decides it for almost everybody watching. Around ninety nine percent of testing work is plain sync.",
      "data": {
        "value": 99,
        "suffix": "%",
        "label": "of testing work is sync",
        "atWord": 17.417,
        "source": "The Playwright Dojo"
      },
      "durationFrames": 423,
      "audio": "audio/pw-dojo-03-sync-async_long_s23.mp3",
      "timingSource": "tts"
    },
