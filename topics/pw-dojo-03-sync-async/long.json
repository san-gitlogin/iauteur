    {
      "id": "s26",
      "type": "STICKY_NOTE",
      "transition": "slide",
      "background": "zoneB",
      "narration": "One rule of thumb to carry out of here, and it will serve you for years. Learn sync properly. Recognise async when you see it in the wild. And reach for async only when you genuinely need many things happening at once.",
      "data": {
        "stickyNote": {
          "headline": "The rule of thumb",
          "color": "green",
          "notes": [
            {
              "title": "THE RULE OF THUMB",
              "tag": "pro corner",
              "body": "Learn sync. Recognise async. Reach for async only when you genuinely need many pages at once.",
              "highlight": "Learn sync. Recognise async.",
              "asset": "lucide:compass",
              "atWord": 15.167
            }
          ]
        }
