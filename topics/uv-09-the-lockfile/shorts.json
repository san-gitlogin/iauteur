      "narration": "uv sync is exact by default. The folder is made to match the lockfile, and anything not recorded there is an extra. Sounds alarming. It is the point.",
      "data": {
        "uvStage": {
          "kind": "shelf-split",
          "color": "green",
          "headline": "Alarming, and [correct]",
