    {
      "id": "s01",
      "type": "HOOK",
      "transition": "dip",
      "background": "zoneA",
      "narration": "The iPhone 18 Pro can prove that a photograph is a photograph. Start there.",
      "data": {
        "headline": "iPhone 18 Pro",
        "subtext": "A camera that signs its own work",
        "kicker": "September 2026",
