    {
      "id": "s06",
      "type": "APPLE_STAGE",
      "transition": "fade",
      "background": "zoneC",
      "narration": "Now the camera, and this is the real headline. Apple gave the main camera a variable aperture: six laser cut blades that open right up to f one point four eight. Wide open, the sensor drinks light, so a dim room stops looking like one. Close a stop to f one point eight and you've traded some of that glow for a steadier edge.",
      "data": {
        "appleStage": {
          "headline": "Six blades, [four] stops",
          "kind": "aperture-iris",
          "caption": "Wide open at f/1.48",
          "premise": "Six blades set the hole. Area follows one over N squared, so f/4 passes a fourteenth of the light f/1.48 does.",
          "color": "blue",
          "cells": [
            {
              "label": "f/1.48",
              "text": "stop",
              "value": 1.48,
              "sub": "widest",
              "atWord": 22
            },
            {
              "label": "f/1.8",
              "text": "stop",
              "value": 1.8,
              "atWord": 42
            },
            {
              "label": "f/2.8",
              "text": "stop",
              "value": 2.8,
              "atWord": 44
            },
            {
              "label": "f/4",
              "text": "stop",
              "value": 4,
              "sub": "deepest focus"
            }
          ]
        }
      },
      "durationFrames": 638
