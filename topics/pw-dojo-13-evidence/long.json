    {
      "id": "s09",
      "type": "RULE_TEST",
      "transition": "slide",
      "background": "zoneB",
      "narration": "Keep these two apart in your head. Screenshots you write yourself are for people. Bug reports, docs, something a human being actually reads. The flag is for machines. And the flag is what saves you at three in the morning, when nobody's awake to press a button.",
      "data": {
        "ruleTest": {
          "kicker": "two different jobs",
          "rule": "write screenshots for humans, flag them for CI",
          "okLabel": "automatic",
          "noLabel": "by hand",
          "caption": "one you choose. one just happens.",
          "color": "orange",
          "atWord": 1.75,
          "cases": [
            {
              "text": "--screenshot only-on-failure",
              "title": "ok",
              "sub": "every failure, no code",
              "atWord": 16.667
            },
            {
              "text": "page.screenshot() in a test",
              "title": "no",
              "sub": "only where you remembered",
              "atWord": 24.5
