    {
      "id": "s16",
      "type": "CODE_RUN",
      "transition": "push",
      "background": "zoneB",
      "narration": "A trace is the flight recorder. For every single step, Playwright keeps a picture of the page before and after, the action itself, the console, the network calls. All of that, zipped into one file. Two lines switch the recorder on and off.",
      "data": {
        "codeRun": {
          "filename": "trace.py",
          "language": "py",
          "resultLabel": "what is being kept",
          "color": "green",
          "atWord": 2.75,
          "caption": "every step, with everything around it",
          "lines": [
            {
              "text": "context.tracing.start(",
              "detail": "start recording everything",
              "sub": "pictures, actions, logs",
              "label": "on",
              "atWord": 11.333
            },
            {
              "text": "    screenshots=True, snapshots=True,"
            },
            {
              "text": "    sources=True)"
            },
            {
              "text": "# ... your test runs ..."
            },
            {
              "text": ""
            },
            {
              "text": "context.tracing.stop(",
              "detail": "and zip the whole recording",
              "sub": "trace.zip, one file",
              "label": "saved",
              "atWord": 28.583
            },
            {
              "text": "    path=\"trace.zip\")"
            }
          ]
        }
      },
      "durationFrames": 466,
      "audio": "audio/pw-dojo-13-evidence_long_s16.mp3",
      "timingSource": "tts"
    },
