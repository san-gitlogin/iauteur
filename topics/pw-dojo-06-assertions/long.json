      "id": "s21",
      "type": "SPEC_COMPARE",
      "transition": "push",
      "background": "zoneA",
      "narration": "Two of those look almost identical and are not. To have text checks the element's full text, and is forgiving about spacing. To contain text only needs your words somewhere inside it. Reach for the strict one when the exact wording matters.",
      "data": {
        "compare": {
          "headline": "to_have_text vs [to_contain_text]",
          "a": {
            "name": "to_have_text",
            "color": "blue"
          },
          "b": {
            "name": "to_contain_text",
            "color": "purple"
          },
          "rows": [
            {
              "label": "what it matches",
              "a": "the FULL text",
              "b": "a substring"
            },
            {
              "label": "extra words allowed",
              "a": "no",
              "b": "yes"
            },
            {
              "label": "about whitespace",
              "a": "forgiving",
              "b": "forgiving"
            },
            {
              "label": "reach for it when",
              "a": "exact wording",
              "b": "part matters"
            }
          ],
          "atWord": 10.667
        }
      },
      "durationFrames": 428,
      "audio": "audio/pw-dojo-06-assertions_long_s21.mp3",
      "timingSource": "tts"
