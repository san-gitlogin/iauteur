    {
      "id": "s22",
      "type": "CODE_WINDOW",
      "transition": "dip",
      "background": "zoneB",
      "narration": "And when the critic does fail, read the review. Playwright does not just say failed. It tells you exactly what it expected, exactly what it found instead, and a diary of every retry it made along the way.",
      "data": {
        "code": {
          "filename": "test_welcome.py",
          "language": "py",
          "lines": [
            {
              "text": "expect(page.get_by_role(\"heading\")).to_have_text("
            },
            {
              "text": "    \"Welcome, Neo\")"
            }
          ],
          "output": [
