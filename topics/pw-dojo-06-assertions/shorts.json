              "atWord": 1.833
            },
            {
              "label": "not true yet",
              "sub": "no verdict written",
              "color": "orange",
              "atWord": 4.333
            },
            {
              "label": "wait a moment",
              "sub": "then check again",
              "color": "purple",
              "atWord": 6.917
            }
          ]
        }
      },
      "durationFrames": 404,
      "audio": "audio/pw-dojo-06-assertions_short_s03.mp3",
