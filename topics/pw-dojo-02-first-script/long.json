    {
      "id": "s05",
      "type": "CODE_WINDOW",
      "transition": "push",
      "background": "zoneA",
      "narration": "This is a complete, working script. Nine lines. It opens a browser, visits a page, prints the title of that page, saves a photo of it, and closes everything down. Save it as first dot py and run it with python first dot py.",
      "data": {
        "code": {
          "filename": "first.py",
          "language": "py",
          "runLabel": "python first.py",
          "lines": [
            {
              "text": "from playwright.sync_api import sync_playwright"
            },
            {
              "text": ""
            },
            {
              "text": "with sync_playwright() as p:"
            },
            {
              "text": "    browser = p.chromium.launch(headless=False)"
            },
            {
              "text": "    page = browser.new_page()"
            },
            {
              "text": "    page.goto(\"https://playwright.dev\")"
            },
            {
              "text": "    print(page.title())"
            },
            {
              "text": "    page.screenshot(path=\"stage.png\")"
            },
            {
              "text": "    browser.close()"
            }
          ],
          "atWord": 11.167
        }
      },
      "durationFrames": 467,
      "audio": "audio/pw-dojo-02-first-script_long_s05.mp3",
      "timingSource": "tts"
    },
    {
