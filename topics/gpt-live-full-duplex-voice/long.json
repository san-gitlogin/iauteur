    {
      "id": "s07",
      "type": "CONFIDENCE_GATE",
      "narration": "Underneath sits a decision engine: multi-signal turn detection scoring the conversation many times per second, deciding in real time whether to speak, hold, or hand over.",
      "durationFrames": 320,
      "transition": "glitch",
