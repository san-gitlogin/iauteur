    {
      "id": "s03",
      "type": "TITLE_CARD",
      "narration": "This is GPT-Live — OpenAI's new voice engine, and the first full-duplex assistant most people on Earth will ever meet. It rolled out to phones and the web on day one.",
      "durationFrames": 339,
      "transition": "blinds",
      "background": "zoneC",
      "data": {
        "title": "GPT-Live",
        "subtitle": "Full-duplex voice, at scale"
      },
      "timingSource": "tts",
      "audio": "audio/gpt-live-full-duplex-voice_long_s03.mp3"
    },
    {
      "id": "s04",
      "type": "SOUND_WAVE",
      "narration": "Until now, voice AI worked like a walkie-talkie. It recorded you, waited for silence, decided you were done, then finally answered — one direction at a time.",
      "durationFrames": 343,
      "transition": "dip",
      "background": "zoneA",
      "data": {
        "anim": "rise",
        "wave": {
          "label": "One-way audio",
          "bars": 44,
          "atWord": 7.917
        }
      },
      "timingSource": "tts",
      "audio": "audio/gpt-live-full-duplex-voice_long_s04.mp3"
    },
    {
      "id": "s05",
      "type": "API_REQUEST_RESPONSE",
      "narration": "Full-duplex flips that pattern: audio flows in both directions at once, so it hears you even while it's speaking — a phone call, not a radio check-in.",
      "durationFrames": 292,
      "transition": "whippan",
      "background": "zoneB",
      "data": {
        "anim": "slideLeft",
