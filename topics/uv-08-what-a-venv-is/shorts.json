          "highlight": "include-system",
          "steps": [
            {
              "label": "cat .venv/pyvenv.cfg",
              "out": [
                "home = /usr/local/bin",
                "implementation = CPython",
                "uv = 0.12.5",
                "version_info = 3.12.14",
                "include-system-site-packages = false",
                "prompt = invoice-app"
              ],
              "detail": "read the fifth line twice",
              "atWord": 8
