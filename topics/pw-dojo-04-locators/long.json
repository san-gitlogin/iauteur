    {
      "id": "s11",
      "type": "QUIZ_CARD",
      "transition": "push",
      "background": "zoneA",
      "narration": "First check. When does that first line actually go and search the page? Read the four options and answer in your head. Pause the video here if you want longer to think about it. Ready? It is B. The search runs only when you act on it.",
      "data": {
        "quiz": {
          "question": "When does the locator search the page?",
          "options": [
            {
              "text": "The moment the line runs"
            },
            {
              "text": "When you act on it — .click()"
            },
            {
              "text": "When the page finishes loading"
            },
            {
              "text": "Never, it is decoration"
            }
          ],
          "answerIndex": 1,
          "why": "Locators are lazy on purpose — a late button is still found.",
          "revealAtWord": 27.917,
          "atWord": 5
        }
      },
      "durationFrames": 468,
