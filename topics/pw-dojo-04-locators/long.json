              "text": "page.get_by_label(\"Password\")"
            },
            {
              "text": "page.get_by_text(\"Password\")"
            },
            {
              "text": "page.locator(\"input\")"
            }
          ],
          "answerIndex": 1,
          "why": "get_by_text finds the label itself, not the box beside it.",
          "revealAtWord": 24.333,
