    {
      "id": "s12",
      "type": "CHAPTER",
      "transition": "wipe",
      "background": "zoneB",
      "narration": "Now the way you should be describing things almost all of the time.",
      "data": {
        "chapter": {
          "number": "02",
          "title": "get_by_role, the king",
          "subtitle": "Describe it like a human"
        }
      },
      "durationFrames": 122,
