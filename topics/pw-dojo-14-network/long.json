    {
      "id": "s05",
      "type": "TRAP_TRIGGER",
      "transition": "push",
      "background": "zoneA",
      "narration": "Look familiar? You've met this shape twice already. Popups in episode eleven, downloads in twelve. Same deal here. Start listening for a particular reply, do the click inside that block, and afterwards the response is yours to poke at.",
      "data": {
        "trapTrigger": {
          "listener": "with page.expect_response(url)",
          "trigger": "get_by_role(\"button\", \"Save\")",
          "catcher": "response = resp_info.value",
          "caught": "the reply",
          "caughtItems": [
            "status 200",
            "the payload"
          ],
          "originLabel": "the same page",
          "mode": "trap",
          "caption": "trap-then-trigger, third time round",
          "color": "blue",
          "atWord": 1.917,
          "armAtWord": 12.75,
          "fireAtWord": 20.917
        }
      },
