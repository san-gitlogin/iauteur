      "narration": "And here is the whole thing. Twelve lines. Open a browser, go to the login page, fill the username, fill the password, click Login, print whatever the banner says, and close up.",
      "data": {
        "code": {
          "filename": "login.py",
          "language": "py",
          "runLabel": "python login.py",
          "lines": [
            {
              "text": "from playwright.sync_api import sync_playwright"
            },
            {
              "text": "with sync_playwright() as p:"
            },
            {
              "text": "    browser = p.chromium.launch(headless=False)"
            },
            {
              "text": "    page = browser.new_page()"
            },
            {
              "text": "    page.goto(\"https://the-internet.herokuapp.com\""
            },
            {
              "text": "              \"/login\")"
            },
            {
              "text": "    page.get_by_label(\"Username\").fill(\"tomsmith\")",
              "color": "green"
            },
            {
              "text": "    page.get_by_label(\"Password\").fill("
            },
            {
              "text": "        \"SuperSecretPassword!\")",
              "color": "green"
            },
            {
              "text": "    page.get_by_role(\"button\", name=\"Login\").click()",
              "color": "green"
            },
            {
              "text": "    print(page.locator(\"#flash\").inner_text())"
            },
