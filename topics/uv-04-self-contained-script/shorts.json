      "transition": "zoom",
      "background": "zoneA",
      "narration": "The trick is four lines of comments at the top of the file. Python skips them, because comments are comments. uv reads them and builds an environment out of them.",
      "data": {
        "uvStage": {
          "kind": "script-header",
          "color": "green",
          "headline": "A comment Python [ignores]",
          "premise": "Comments to Python. Instructions to uv. The same four lines do both jobs.",
          "stageTitle": "PEP 723, line by line",
          "promptLabel": "you@laptop",
          "cwd": "~/work",
          "steps": [
            {
              "label": "head -4 demo.py",
              "out": [
                "# /// script",
                "# requires-python = \">=3.12\"",
                "# dependencies = [\"rich\"]",
                "# ///"
              ],
              "detail": "four comment lines, and a whole environment",
              "atWord": 7.667
            }
          ],
          "stage": [
