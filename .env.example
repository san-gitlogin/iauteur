# iAuteur AI automation — provider credentials.
# Copy this file to `.env` (same folder) and fill in ONE provider block.
# `.env` is gitignored — your keys never get committed. NEVER share the key.
#
# Pick a provider with IAUTEUR_AI_PROVIDER (azure | openai | huggingface | groq |
# together | openrouter | ollama | custom | litellm). If you set the AZURE_* block
# the adapter auto-selects Azure even without IAUTEUR_AI_PROVIDER.

# ── Azure OpenAI (classic deployments) ──────────────────────────────────────
IAUTEUR_AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=PUT-YOUR-KEY-HERE
AZURE_OPENAI_MAX_TOKENS=4000
AZURE_OPENAI_TEMPERATURE=0.3
AZURE_OPENAI_TIMEOUT=120

# ── OpenAI / OpenAI-compatible (uncomment + set IAUTEUR_AI_PROVIDER above) ───
# IAUTEUR_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# IAUTEUR_AI_MODEL=gpt-4o

# ── Hugging Face router (one token → 15+ providers) ─────────────────────────
# IAUTEUR_AI_PROVIDER=huggingface
# HF_TOKEN=hf_...
# IAUTEUR_AI_MODEL=openai/gpt-oss-120b:fastest

# ── Any other OpenAI-compatible endpoint (Groq/Together/OpenRouter/Ollama/…) ─
# IAUTEUR_AI_PROVIDER=custom
# IAUTEUR_AI_BASE_URL=https://host/v1
# IAUTEUR_AI_MODEL=model-name
# IAUTEUR_AI_API_KEY=...
